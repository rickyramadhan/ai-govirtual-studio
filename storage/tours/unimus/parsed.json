        {
            "infoId": 1110,
            "label": "Unimus Tv",
            "description": "Unimus Tv Layanan media ini berfungsi sebagai sarana informasi, komunikasi, dan wadah kreativitas mahasiswa dalam bidang penyiaran digital. Fasilitas ini juga menjadi laboratorium praktis bagi pengembangan konten audiovisual yang edukatif di lingkungan universitas.",
            "fragment": "unimustv",
            "link": "unimus/index.html#unimustv",
