        },
        {
            "infoId": 1113,
            "label": "Laboratorium",
            "description": "Laboratorium Fasilitas ini mencakup berbagai ruang praktik spesifik yang disesuaikan dengan kebutuhan setiap program studi, mulai dari kesehatan hingga teknik. Setiap ruang dilengkapi dengan instrumen penelitian standar industri untuk mendukung kegiatan praktikum dan inovasi mahasiswa.",
            "fragment": "laboratorium",
            "link": "unimus/index.html#laboratorium",
            "sceneId": "node115"
        },
        {
            "infoId": 1114,
            "label": "Lapangan Badminton",
            "description": "Lapangan Badminton Fasilitas olahraga dalam ruangan ini menyediakan lapangan yang standar untuk menunjang minat dan bakat mahasiswa di cabang bulu tangkis. Area ini menjadi pusat latihan rutin bagi unit kegiatan mahasiswa untuk mempersiapkan diri menghadapi berbagai kejuaraan.",
            "fragment": "badminton",
            "link": "unimus/index.html#badminton",
