        {
            "infoId": 1112,
            "label": "Perpustakaan",
            "description": "Perpustakaan Pusat sumber belajar ini menyediakan koleksi literatur yang lengkap, baik dalam bentuk cetak maupun akses jurnal digital internasional. Suasana yang tenang dan fasilitas ruang diskusi menjadikannya tempat ideal untuk riset dan pengembangan akademik.",
            "fragment": "perpustakaan",
            "link": "unimus/index.html#perpustakaan",
