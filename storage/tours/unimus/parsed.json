        {
            "infoId": 1111,
            "label": "Lab Simulasi Dokter",
            "description": "Lab Simulasi Dokter Laboratorium ini dirancang menyerupai lingkungan medis nyata untuk melatih keterampilan klinis mahasiswa kedokteran sebelum terjun ke rumah sakit. Ruangan ini dilengkapi dengan manekin dan peralatan medis canggih guna memastikan standar kompetensi praktik yang tinggi.",
            "fragment": "labsimulasi",
            "link": "unimus/index.html#labsimulasi",
