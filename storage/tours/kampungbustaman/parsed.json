    "objects": [
        {
            "infoId": 121,
            "label": "Mushola Tua",
            "description": "Bangunan ibadah Islam berskala kecil yang telah berdiri puluhan hingga ratusan tahun di permukiman bersejarah, menjadikannya penanda awal penyebaran dan pusat kegiatan keagamaan lokal. Bangunan ini tidak hanya berfungsi sebagai tempat shalat, tetapi juga sebagai warisan budaya (cagar budaya) yang menyimpan nilai sejarah, arsitektur tradisional, dan memori kolektif masyarakat kampung tersebut.",
            "fragment": "musholatua",
            "link": "kampungbustaman/index.html#MusholaTua",
            "sceneId": "node74"
        },
        {
            "infoId": 122,
            "label": "Sumur Tua",
            "description": "Sumber air tanah yang dibangun pada masa lampau, berfungsi sebagai urat nadi kehidupan masyarakat kampung tersebut untuk memenuhi kebutuhan air minum, memasak, hingga ritual. Keberadaan sumur ini bukan hanya warisan infrastruktur kuno, tetapi juga situs sejarah dan budaya yang menyimpan kisah, legenda, dan menjadi pusat interaksi sosial antarwarga selama berabad-abad.",
            "fragment": "sumurtua",
            "link": "kampungbustaman/index.html#SumurTua",
            "sceneId": "node77"
        },
        {
            "infoId": 123,
            "label": "Rumah Pemotongan",
            "description": "Tempat pemotongan hewan (khususnya kambing) yang dijalankan secara tradisional oleh warga setempat secara turun-temurun, menjadikan kampung tersebut sentra niaga daging sejak lama. Fasilitas ini bukan hanya tempat jagal, tetapi juga pusat aktivitas ekonomi yang membentuk identitas kampung, yang kini sebagian fungsinya bergeser menjadi pusat pengolahan kepala kambing (bengkel kepala) saat Idul Adha.",
            "fragment": "rumahpemotongan",
            "link": "kampungbustaman/index.html#RumahPemotongan",
            "sceneId": "node78"
        },
        {
            "infoId": 124,
            "label": "Rumah Jengki",
            "description": "Salah satu jenis hunian bersejarah yang dibangun pasca-kemerdekaan (sekitar 1950-1960an), yang berfungsi sebagai simbol arsitektur nasionalis yang menolak gaya kolonial kaku. Arsitektur ini ditandai dengan bentuk atap pelana yang tidak simetris, dinding miring (segi lima atau trapesium terbalik) pada fasad, serta penggunaan ornamen roster atau batu alam, mencerminkan semangat anti-kemapanan dan pencarian jati diri Indonesia.",
            "fragment": "rumahjengki",
            "link": "kampungbustaman/index.html#RumahJengki",
            "sceneId": "node76"
        }
    ],
