    "objects": [
        {
            "infoId": 1124,
            "label": "Ballroom",
            "description": "RSWN memiliki fasilitas Ballroom yang terletak di gedung Paviliun Amarta. Ruangan ini tidak hanya berfungsi untuk kegiatan internal, tetapi juga menjadi pusat edukasi medis. Digunakan untuk seminar kesehatan, pertemuan ilmiah para dokter, serta acara-acara formal lainnya. Memiliki kapasitas yang cukup besar dengan fasilitas audio-visual modern, yang mencerminkan RSWN sebagai \"Smart Hospital.\"",
            "fragment": "ballroom",
            "link": "rswongsonegoro/index.html#ballroom",
            "sceneId": "node25"
        },
        {
            "infoId": 1125,
            "label": "Ruang Operasi",
            "description": "RSWN mengoperasikan kamar bedah yang terintegrasi untuk berbagai tindakan, mulai dari bedah umum hingga bedah saraf dan jantung. Menggunakan standar Modular Operating Theatre (MOT), sebuah sistem ruang operasi yang terintegrasi dalam satu panel kontrol sehingga lebih higienis, efisien, dan aman. Mendukung tindakan bedah minimal invasif (laparoskopi) yang memungkinkan pemulihan pasien jauh lebih cepat.",
            "fragment": "ruangoperasi",
            "link": "rswongsonegoro/index.html#ruangoperasi",
            "sceneId": "node31"
        },
        {
            "infoId": 1126,
            "label": "Hidroterapi",
            "description": "Ini adalah salah satu fasilitas unggulan RSWN yang jarang dimiliki rumah sakit lain secara lengkap di Jawa Tengah. Terapi rehabilitasi yang memanfaatkan media air untuk pemulihan fisik. Sangat efektif bagi pasien pasca-stroke, pasien dengan masalah sendi, saraf terjepit (HNP), atau rehabilitasi cedera olahraga karena beban tubuh berkurang saat berada di dalam air.",
            "fragment": "hidroterapi",
            "link": "rswongsonegoro/index.html#hidroterapi",
            "sceneId": "node41"
        },
        {
            "infoId": 1127,
            "label": "Teknologi Kanker",
            "description": "RSWN terus mengembangkan layanan kanker dengan teknologi terbaru guna memfasilitasi deteksi dini dan pengobatan intensif. Mencakup layanan kemoterapi yang nyaman serta deteksi melalui laboratorium patologi anatomi yang akurat. Layanan ini biasanya didukung oleh dokter spesialis onkologi multidisiplin untuk menangani berbagai jenis kanker secara komprehensif.",
            "fragment": "teknologikanker",
            "link": "rswongsonegoro/index.html#teknologikanker",
            "sceneId": "node26"
        },
        {
            "infoId": 1128,
            "label": "Kateterisasi Laboratorium",
            "description": "Fasilitas ini adalah tulang punggung layanan jantung dan pembuluh darah di RSWN. Digunakan untuk prosedur diagnostik dan intervensi jantung, seperti pemasangan ring (stent), pemetaan jantung, dan penanganan serangan jantung akut. Memungkinkan tindakan dilakukan tanpa bedah terbuka (minimal invasif), hanya melalui akses pembuluh darah kecil di pergelangan tangan atau paha.",
            "fragment": "cathlab",
            "link": "rswongsonegoro/index.html#cathlab",
            "sceneId": "node27"
        },
        {
            "infoId": 1129,
            "label": "Pemindaian MRI",
            "description": "RSWN dilengkapi dengan unit MRI terbaru (biasanya 1.5 Tesla) untuk pemeriksaan radiologi tanpa radiasi sinar-X. Menghasilkan gambar organ tubuh bagian dalam (seperti otak, saraf tulang belakang, otot, dan jaringan lunak) dengan sangat detail. Sangat krusial untuk mendiagnosis penyakit saraf, tumor, hingga cedera ligamen secara akurat tanpa efek samping radiasi bagi pasien.",
            "fragment": "mriscan",
            "link": "rswongsonegoro/index.html#mriscan",
            "sceneId": "node30"
        }
    ],
