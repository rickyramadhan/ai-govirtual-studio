    "objects": [
        {
            "infoId": 135,
            "label": "Area Makan Indoor",
            "description": "Area makan di luar ruangan Koena Koeni menawarkan suasana yang sejuk dan asri, memungkinkan pengunjung menikmati hidangan sambil menikmati panorama Kota Semarang, terutama di malam hari. Area ini sangat cocok bagi tamu yang ingin bersantap dalam suasana terbuka dan santai.",
            "fragment": "dineinindoor",
            "link": "koenakoeni/index.html#dineinindoor",
            "sceneId": "node1"
        },
        {
            "infoId": 136,
            "label": "Area Makan Outdoor",
            "description": "Area makan di dalam ruangan dirancang dengan konsep kafe galeri yang unik, dipenuhi dengan aneka pernak-pernik dan koleksi barang-barang antik atau kuno. Suasana interior yang antik dan elegan ini memberikan pengalaman bersantap yang unik seolah kembali ke masa lalu.",
            "fragment": "dineinoutdoor",
            "link": "koenakoeni/index.html#dineinoutdoor",
            "sceneId": "node4"
        },
        {
            "infoId": 137,
            "label": "Area Komersil Batik",
            "description": "Koena Koeni memiliki galeri yang berfungsi sebagai area komersil, di mana pengunjung dapat melihat dan membeli koleksi kain batik tulis yang dipajang. Area ini tidak hanya berfungsi sebagai pajangan, tetapi juga sebagai tempat untuk melestarikan dan memasarkan produk kerajinan tradisional Indonesia.",
            "fragment": "areakomersilbatik",
            "link": "koenakoeni/index.html#areakomersilbatik",
            "sceneId": "node16"
        },
        {
            "infoId": 138,
            "label": "VIP Room",
            "description": "Fasilitas khusus yang dirancang untuk memberikan pengalaman bersantap yang lebih privat dan eksklusif. Ruangan ini cocok digunakan untuk acara keluarga intim, pertemuan bisnis, atau perayaan yang membutuhkan suasana tenang dan layanan yang lebih personal.",
            "fragment": "viproom",
            "link": "koenakoeni/index.html#viproom",
            "sceneId": "node3"
        }
    ],
