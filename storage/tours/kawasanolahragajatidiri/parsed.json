    "objects": [
        {
            "infoId": 474,
            "label": "Cycling",
            "description": "GOR Jatidiri memiliki lintasan khusus untuk olahraga in-line skate atau sepatu roda yang juga dapat dimanfaatkan untuk latihan cycling atau sepeda balap trek. Lintasan ini dirancang dengan standar yang memadai untuk mendukung latihan atlet dan kegiatan rekreasi masyarakat.",
            "fragment": "cycling",
            "link": "jatidiri/index.html#cycling",
            "sceneId": "node92"
        },
        {
            "infoId": 475,
            "label": "Kolam Renang",
            "description": "Kompleks ini memiliki kolam renang yang telah direnovasi sesuai standar internasional dan pernah menjadi venue resmi untuk cabang olahraga renang ASEAN Para Games 2022. Kolam renang ini dibuka untuk umum dengan harga terjangkau, melayani kebutuhan latihan atlet maupun rekreasi masyarakat.",
            "fragment": "kolamrenang",
            "link": "jatidiri/index.html#kolamrenang",
            "sceneId": "node89"
        },
        {
            "infoId": 476,
            "label": "Volleyball Stadium",
            "description": "Arena indoor modern yang dirancang khusus untuk pertandingan bola voli, bukan stadion utama sepak bola. Arena ini dikenal memiliki kapasitas penonton sekitar 6.000 kursi dan secara rutin dijadikan venue bergengsi, termasuk ajang voli profesional nasional seperti Proliga, bahkan sering menjadi lokasi pembukaan atau babak Final Four kompetisi tersebut.",
            "fragment": "vollyball",
            "link": "jatidiri/index.html#vollyball",
            "sceneId": "node86"
        },
        {
            "infoId": 477,
            "label": "Panjat Tebing",
            "description": "Terdapat arena atau fasilitas panjat dinding yang disediakan di kompleks GOR Jatidiri untuk menunjang latihan dan kompetisi atlet panjat tebing. Area ini melengkapi sarana olahraga ekstrem di GOR Jatidiri dan dapat digunakan oleh masyarakat umum melalui sistem sewa.",
            "fragment": "panjattebing",
            "link": "jatidiri/index.html#panjattebing",
            "sceneId": "node83"
        },
        {
            "infoId": 478,
            "label": "Lapangan Tennis",
            "description": "GOR Jatidiri dilengkapi dengan beberapa blok lapangan tenis outdoor yang telah direnovasi dan memenuhi standar, sering digunakan untuk turnamen atau latihan. Lapangan ini dapat disewa oleh masyarakat yang ingin berolahraga tenis.",
            "fragment": "lapangantennis",
            "link": "jatidiri/index.html#lapangantennis",
            "sceneId": "node95"
        },
        {
            "infoId": 479,
            "label": "Stadion",
            "description": "Stadion Jatidiri adalah landmark utama kompleks GOR yang berkapasitas besar dengan single seat modern, dan menjadi markas klub PSIS Semarang. Stadion ini dilengkapi dengan rumput dan pencahayaan berstandar internasional, serta lintasan atletik di sekelilingnya.",
            "fragment": "stadion",
            "link": "jatidiri/index.html#stadion",
            "sceneId": "node98"
        },
        {
            "infoId": 480,
            "label": "Boxing",
            "description": "Fasilitas untuk tinju (boxing) biasanya diwadahi di Gedung Olahraga (GOR) Indoor utama yang serbaguna di dalam kompleks Jatidiri. Gedung Indoor ini menyediakan ruang yang cukup untuk latihan dan sparring, serta bisa digunakan untuk menyelenggarakan pertandingan tinju.",
            "fragment": "boxing",
            "link": "jatidiri/index.html#boxing",
            "sceneId": "node82"
        }
    ],
