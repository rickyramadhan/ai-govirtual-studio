    "objects": [
        {
            "infoId": 144,
            "label": "Lobi Gedung DPRD",
            "description": "Lobby gedung DPRD adalah area penerimaan utama dan titik pertemuan bagi tamu, masyarakat, dan anggota dewan sebelum memasuki ruang-ruang rapat penting. Area ini difungsikan sebagai pusat informasi dan sering dirancang untuk kesan formal dan terbuka, mencerminkan fungsi lembaga perwakilan rakyat.",
            "fragment": "lobidprd",
            "link": "gubernurjawatengah/index.html#lobidprd",
            "sceneId": "node82"
        },
        {
            "infoId": 145,
            "label": "Lobi Gedung Gubernur",
            "description": "Lobby gedung gubernur berfungsi sebagai pintu masuk sekaligus area layanan publik utama bagi masyarakat. Area di lantai 1 tersebut telah diresmikan sebagai \"Rumah Rakyat,\" yang difungsikan untuk menerima aduan, menyerap aspirasi, dan memfasilitasi komunikasi dua arah antara pemerintah dengan warga.",
            "fragment": "lobigubernur",
            "link": "gubernurjawatengah/index.html#lobigubernur",
            "sceneId": "node83"
        },
        {
            "infoId": 146,
            "label": "Ruang Konferensi Gedung Gubernur",
            "description": "Ruang rapat gedung gubernur adalah ruangan khusus yang dirancang dan dilengkapi secara teknis untuk memfasilitasi pertemuan, seminar, atau diskusi formal berskala besar hingga kecil di area gedung gubernur Jawa Tengah.",
            "fragment": "ruangkonferensi",
            "link": "gubernurjawatengah/index.html#ruangkonferensi",
            "sceneId": "node86"
        }
