    "objects": [
        {
            "infoId": 431,
            "label": "Klinik Utama Dermanina",
            "description": "Klinik Utama Dermanina merupakan unit pelayanan kesehatan klinis yang terintegrasi di dalam atau terafiliasi dengan SCCR. Klinik ini menyediakan layanan medis dan konsultasi yang berhubungan dengan implementasi terapi sel punca dan riset kanker.",
            "fragment": "klinikutamadermanina",
            "link": "sccr/index.html#klinikutamadermanina",
            "sceneId": "node97"
        },
        {
            "infoId": 432,
            "label": "Integrated Laboratory",
            "description": "Integrated Laboratory (Laboratorium Terpadu) berfungsi sebagai pusat fasilitas inti yang dilengkapi dengan peralatan canggih. Tempat ini digunakan oleh para peneliti untuk melakukan riset mendalam di bidang sel punca, secretome, dan kanker.",
            "fragment": "integratedlaboratory",
            "link": "sccr/index.html#integratedlaboratory",
            "sceneId": "node88"
        },
        {
            "infoId": 433,
            "label": "Lab Produksi",
            "description": "Lab Produksi adalah fasilitas berstandar industri farmasi (CPOB) yang berfokus pada pengolahan dan pengembangan produk sel punca (stem cell) dan secretome. Laboratorium ini memastikan produk yang dihasilkan memiliki standar kualitas global untuk aplikasi medis.",
            "fragment": "labproduksi",
            "link": "sccr/index.html#labproduksi",
            "sceneId": "node98"
        },
        {
            "infoId": 434,
            "label": "Air Supply",
            "description": "Air Supply (AHU - Air Handling Unit) adalah sistem penunjang penting yang memastikan kualitas dan sterilitas udara dalam area sensitif seperti clean room dan laboratorium. Sistem ini berfungsi untuk mengontrol suhu, kelembapan, dan pertukaran udara agar memenuhi standar riset dan produksi yang ketat.",
            "fragment": "airsupply",
            "link": "sccr/index.html#airsupply",
            "sceneId": "node80"
        },
        {
            "infoId": 435,
            "label": "Ruang Meeting",
            "description": "Ruang Meeting adalah fasilitas yang digunakan untuk pertemuan, diskusi ilmiah, atau penjajakan kerja sama antara tim SCCR dengan mitra institusi, universitas, atau rumah sakit. Ruangan ini memfasilitasi komunikasi dan perencanaan strategis terkait riset dan pelayanan.",
            "fragment": "ruangmeeting",
            "link": "sccr/index.html#ruangmeeting",
            "sceneId": "node107"
        },
        {
            "infoId": 436,
            "label": "Pool Resort",
            "description": "Area Kolam Renang Resor yang mengacu pada fasilitas rekreasi dan relaksasi yang disediakan untuk menunjang kawasan penginapan eksklusif di lingkungan SCCR. Fasilitas ini menawarkan suasana santai untuk keluarga pasien, tamu, atau peneliti.",
