    "objects": [
        {
            "infoId": 1054,
            "label": "Hall Besar",
            "description": "Hall Besar di restoran ini merupakan ruang serbaguna utama yang memiliki kapasitas sangat luas, mampu menampung ratusan hingga ribuan tamu dalam satu waktu. Ruangan ini menjadi pilihan utama bagi mereka yang ingin melangsungkan acara berskala besar seperti resepsi pernikahan, seminar nasional, acara gathering perusahaan, hingga peluncuran produk.",
            "fragment": "hallbesar",
            "link": "gamacandiresto/index.html#hallbesar",
            "sceneId": "node4"
        },
        {
            "infoId": 1055,
            "label": "Taman",
            "description": "Taman ini dirancang dengan konsep resort yang menonjolkan nuansa natural, lengkap dengan pepohonan tinggi dan tanaman hijau yang memberikan kesegaran udara khas perbukitan Mijen. Taman ini juga sering kali dialihfungsikan menjadi venue untuk acara luar ruangan seperti outdoor wedding, gathering perusahaan, hingga kegiatan outbound ringan.",
            "fragment": "taman",
            "link": "gamacandiresto/index.html#taman",
            "sceneId": "node11"
        },
        {
            "infoId": 1056,
            "label": "Ruang Rapat Besar",
            "description": "Gama Candi Resto merupakan fasilitas utama bagi perusahaan atau instansi yang ingin menyelenggarakan agenda berskala luas, seperti rapat koordinasi tahunan, pelatihan karyawan (training), atau seminar. Ruangan ini memiliki kapasitas yang cukup besar untuk menampung banyak peserta.",
            "fragment": "meetingbesar",
            "link": "gamacandiresto/index.html#meetingbesar",
            "sceneId": "node8"
        },
        {
            "infoId": 1057,
            "label": "Ruang VIP",
            "description": "Ruangan ini sangat ideal untuk pertemuan bisnis tertutup, rapat staf, arisan keluarga, atau perayaan ulang tahun terbatas dengan kapasitas mulai dari belasan hingga puluhan orang. Meskipun ukurannya lebih kompak, Hall Kecil tetap dilengkapi dengan fasilitas modern seperti pendingin ruangan (AC), proyektor, dan jaringan Wi-Fi untuk mendukung produktivitas.",
            "fragment": "meetingvip",
            "link": "gamacandiresto/index.html#meetingvip",
            "sceneId": "node13"
        },
        {
            "infoId": 1058,
            "label": "Ruang Rapat Kecil",
            "description": "Ruang Rapat Kecil disediakan bagi mereka yang membutuhkan ruang diskusi yang lebih fokus, privat, dan eksklusif. Ruangan ini sangat ideal untuk pertemuan direksi, negosiasi bisnis dengan klien, atau rapat tim kecil yang memerlukan ketenangan tanpa gangguan dari area publik restoran.",
            "fragment": "meetingkecil",
            "link": "gamacandiresto/index.html#meetingkecil",
            "sceneId": "node7"
        },
        {
            "infoId": 1059,
            "label": "Bar",
            "description": "Area bar di Gama Candi Resto Semarang hadir dengan konsep yang elegan dan modern, berfungsi sebagai pusat penyajian aneka minuman segar yang melengkapi hidangan utama seafood dan masakan Nusantara. Bar ini dirancang dengan penataan yang rapi dan estetis, sering kali menjadi titik fokus visual yang menarik bagi pengunjung saat baru memasuki area restoran.",
            "fragment": "bar",
            "link": "gamacandiresto/index.html#bar",
            "sceneId": ""
        }
    ],
