    "objects": [
        {
            "infoId": 1069,
            "label": "Mini Galeri Sejarah",
            "description": "Area ini merupakan ruang museum mini atau galeri sejarah di Dharma Boutique Roastery (dahulu dikenal sebagai Coffee Factory \"Margo Redjo\") yang menyimpan koleksi mesin-mesin pengolahan kopi antik. Berada di dalam bangunan bergaya kolonial dengan atap seng gelombang yang tinggi, area ini memamerkan warisan industri kopi dari awal abad ke-20.",
            "fragment": "minigalerisejarah",
            "link": "dharmaboutique/index.html#minigalerisejarah",
            "sceneId": "node7"
        },
        {
            "infoId": 1070,
            "label": "Area Outdoor",
            "description": "Area ini didominasi oleh sebuah bangunan putih bergaya Indische dengan pilar-pilar besar dan lantai marmer yang memberikan kesan klasik sekaligus megah. Pemanfaatan kanopi alami dari pepohonan rindang di sekeliling halaman menciptakan suasana yang sejuk dan tenang, menjadikannya tempat yang sangat nyaman untuk bersantai di luar ruangan meski di siang hari.",
            "fragment": "areaoutdoor",
            "link": "dharmaboutique/index.html#areaoutdoor",
            "sceneId": "node6"
        },
        {
            "infoId": 1071,
            "label": "Area Sangrai",
            "description": "Keberadaannya di area terbuka tersebut menunjukkan proses produksi yang transparan, di mana pengunjung dapat melihat langsung alat yang digunakan untuk menghasilkan aroma kopi yang khas. Mesin dengan material logam yang tampak kokoh ini berfungsi untuk menyangrai biji kopi mentah menggunakan sistem pemanas khusus guna memunculkan profil rasa yang optimal.",
            "fragment": "areasangrai",
            "link": "dharmaboutique/index.html#areasangrai",
            "sceneId": "node5"
        },
        {
            "infoId": 1072,
            "label": "Ruang Utama",
            "description": "Begitu memasuki ruangan, pandangan Anda akan langsung tertuju pada meja bar kayu panjang yang berjajar dengan toples-toples kaca berisi berbagai jenis biji kopi pilihan (single origin), mulai dari robusta hingga arabika dari berbagai daerah di Indonesia. Lantai tegel klasik berwarna kuning dengan aksen hijau di tepinya serta langit-langit yang tinggi memberikan kesan ruang yang luas, sejuk, dan autentik, seolah membawa pengunjung kembali ke masa lalu.",
            "fragment": "ruangutama",
            "link": "dharmaboutique/index.html#ruangutama",
            "sceneId": "node1"
        }
    ],
