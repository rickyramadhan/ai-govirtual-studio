    "objects": [
        {
            "infoId": 538,
            "label": "Mini Zoo",
            "description": "Mini Zoo adalah wahana tambahan yang dirancang khusus untuk anak-anak, berisikan koleksi satwa jinak yang dapat dilihat dan diajak berinteraksi. Wahana ini melengkapi daya tarik utama Koeta Toea sebagai pusat oleh-oleh dan spot foto tematik, memungkinkan anak-anak bermain dan berinteraksi dengan hewan saat orang tua berbelanja.",
            "fragment": "minizoo",
            "link": "koetatoea/index.html#minizoo",
            "sceneId": "node12"
        },
        {
            "infoId": 539,
            "label": "Foodcourt Outdoor",
            "description": "Foodcourt Outdoor adalah area kuliner yang menampung belasan UMKM lokal, menyajikan beragam olahan masakan, di bawah dekorasi bangunan bergaya Eropa klasik. Area ini dirancang terbuka dan Instagrammable agar pengunjung dapat menikmati aneka hidangan dengan suasana yang unik dan nyaman sambil berfoto.",
            "fragment": "foodcourtoutdoor",
            "link": "koetatoea/index.html#foodcourtoutdoor",
            "sceneId": "node5"
        },
        {
            "infoId": 540,
            "label": "Panggung Entertainment",
            "description": "Panggung Entertainment adalah area hiburan yang secara rutin menampilkan pertunjukan live music, khususnya pada akhir pekan (weekend), untuk memeriahkan suasana kuliner dan berswafoto para pengunjung. Panggung ini berfungsi memberikan nilai tambah berupa hiburan yang unik dan menyenangkan, membuat pengalaman bersantap dan berkumpul di Koeta Toea semakin berkesan.",
            "fragment": "panggungentertaiment",
            "link": "koetatoea/index.html#panggungentertaiment",
            "sceneId": "node4"
        },
        {
            "infoId": 541,
            "label": "Gudang Lampu",
            "description": "Gudang Lampu adalah ruangan khusus yang terletak di dalam Koeta Toea, didesain sebagai spot foto Instagrammable dengan dekorasi futuristik penuh lampu neon berwarna-warni dan lighting unik. Tempat ini menawarkan berbagai setting visual, termasuk lampu gantung artistik dan cermin, menjadikannya destinasi favorit bagi pengunjung, khususnya kaum milenial, untuk berswafoto dan membuat konten.",
            "fragment": "gudanglampu",
            "link": "koetatoea/index.html#gudanglampu",
            "sceneId": "node9"
        },
        {
            "infoId": 542,
            "label": "Toko Oleh-Oleh",
            "description": "Toko Oleh-Oleh adalah pusat perbelanjaan utama di bagian depan lokasi wisata yang menyajikan beberapa produk dari UMKM Jawa Tengah dan sekitarnya. Area ini menjual beragam oleh-oleh, mulai dari makanan khas seperti bandeng presto dan lumpia, hingga kerajinan tangan dan souvenir bertema Semarang.",
            "fragment": "tokooleholeh",
            "link": "koetatoea/index.html#tokooleholeh",
            "sceneId": "node6"
        }
    ],
