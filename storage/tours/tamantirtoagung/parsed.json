    "objects": [
        {
            "infoId": 948,
            "label": "Sign Taman Tirto Agung",
            "description": "Sign ini didesain dengan gaya modern menggunakan huruf timbul berukuran besar yang biasanya dicat dengan warna-warna cerah agar terlihat mencolok dan mudah dikenali dari kejauhan. Penempatannya sangat strategis di area depan atau pintu masuk utama, sehingga sering menjadi titik fokus sekaligus landmark bagi masyarakat sekitar maupun wisatawan.",
            "fragment": "signtaman",
            "link": "tamantirto/index.html#signtaman",
            "sceneId": "node209"
        },
        {
            "infoId": 949,
            "label": "Playground",
            "description": "Area playground di Taman Tirto Agung Semarang menjadi salah satu daya tarik utama bagi keluarga karena menawarkan perpaduan fasilitas bermain gratis dan wahana permainan berbayar yang beragam. Di area publik, anak-anak dapat menikmati fasilitas standar seperti ayunan, perosotan, dan jungkat-jungkit yang disediakan secara gratis oleh pengelola.",
            "fragment": "playground",
            "link": "tamantirto/index.html#playground",
            "sceneId": "node217"
        },
        {
            "infoId": 950,
            "label": "Lapangan Voli",
            "description": "Fasilitas lapangan voli di Taman Tirto Agung Semarang merupakan bagian dari sarana olahraga terbuka untuk mendukung aktivitas fisik masyarakat, khususnya warga Banyumanik. Lapangan ini berukuran standar sekitar 9 Ã— 18 meter dan menggunakan lantai paving blok, sehingga pemain disarankan memakai alas kaki olahraga demi keamanan dan kenyamanan.",
            "fragment": "lapanganvoli",
            "link": "tamantirto/index.html#lapanganvoli",
            "sceneId": "node218"
        },
        {
            "infoId": 951,
            "label": "Wall Climbing",
            "description": "Fasilitas wall climbing di Taman Tirto Agung Semarang menjadi salah satu ciri khas yang membedakan taman ini dari ruang terbuka hijau lainnya di Kota Semarang. Terletak di bagian belakang kawasan taman, fasilitas ini terdiri dari tiga papan panjat dengan karakteristik berbeda untuk mengakomodasi berbagai tingkat kemampuan, termasuk papan rendah untuk anak-anak dan papan yang lebih tinggi untuk pengguna dewasa.",
            "fragment": "wallclimbing",
            "link": "tamantirto/index.html#wallclimbing",
            "sceneId": "node207"
        },
        {
            "infoId": 952,
            "label": "UMKM",
            "description": "Aktivitas UMKM di Taman Tirto Agung Semarang menjadi penggerak utama ekonomi kawasan, khususnya dari sektor kuliner dan hiburan anak. Kehadiran UMKM ini telah berkembang menjadi daya tarik tersendiri yang mengundang banyak pengunjung, sehingga taman ini dikenal luas sebagai pusat kuliner malam dan tempat bersantai favorit warga Banyumanik.",
            "fragment": "umkm",
            "link": "tamantirto/index.html#umkm",
            "sceneId": "node208"
        }
    ],
