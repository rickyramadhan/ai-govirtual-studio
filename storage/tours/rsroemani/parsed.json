    "objects": [
        {
            "infoId": 188,
            "label": "Klinik Eksekutif (GIGI)",
            "description": "Klinik Eksekutif Gigi di RS Roemani Semarang, yang juga dikenal sebagai Poli Eksekutif Yusuf, menyediakan layanan gigi dan mulut dengan fasilitas premium dan jadwal dokter spesialis yang lebih fleksibel. Layanan ini melayani pasien umum dan asuransi, menawarkan pemeriksaan dan perawatan spesialisasi seperti Orthodonti, Endodonsi (Konservasi Gigi), Bedah Mulut, dan Pedodontis (Gigi Anak).",
            "fragment": "klinikeksekutif",
            "link": "rsroemani/index.html#klinikeksekutif",
            "sceneId": "node16"
        },
        {
            "infoId": 189,
            "label": "Laboratorium",
            "description": "Fasilitas Laboratorium di RS Roemani Semarang adalah unit penunjang klinik vital yang melayani berbagai pemeriksaan kesehatan untuk diagnosis penyakit dan evaluasi terapi. Layanan laboratorium ini mencakup berbagai spesialisasi, seperti Patologi Klinik dan Patologi Anatomi, serta berfungsi untuk mendukung pelayanan rawat jalan, rawat inap, hingga Unit Gawat Darurat (UGD).",
            "fragment": "laboratorium",
            "link": "rsroemani/index.html#laboratorium",
            "sceneId": "node15"
        },
        {
            "infoId": 190,
            "label": "Kamar VIP",
            "description": "Fasilitas kamar rawat inap VIP di RS Roemani Semarang dirancang untuk memberikan kenyamanan maksimal dan privasi tinggi bagi pasien selama masa pemulihan. Kamar ini umumnya menawarkan fasilitas yang lengkap, meliputi tempat tidur pasien elektrik, kamar mandi dalam, TV, kulkas, serta sofa atau ruang tunggu terpisah untuk penunggu pasien.",
            "fragment": "kamarvip",
            "link": "rsroemani/index.html#kamarvip",
            "sceneId": "node3"
        },
        {
            "infoId": 191,
            "label": "kamar VVIP",
            "description": "Fasilitas kamar VVIP di RS Roemani Semarang, yang dikategorikan sebagai President Suite (misalnya Ruang Sulaiman 7), menawarkan akomodasi rawat inap paling eksklusif dengan desain modern dan elegan. Fasilitasnya mencakup kulkas, mini kitchen, microwave, kursi kerja, dan sofa penunggu, yang dirancang untuk memberikan pengalaman layanan kesehatan layaknya di hotel bintang lima.",
            "fragment": "kamarvvip",
            "link": "rsroemani/index.html#kamarvvip",
            "sceneId": "node4"
        },
        {
            "infoId": 192,
            "label": "CT SCAN",
            "description": "Fasilitas CT Scan (Computed Tomography Scan) di RS Roemani Semarang merupakan unit peralatan canggih yang berada di Instalasi Radiologi dan digunakan untuk menghasilkan gambar detail organ tubuh secara cross-sectional. Alat ini sangat vital untuk membantu diagnosis berbagai kondisi medis, termasuk mendeteksi kelainan pada kepala, paru-paru, tulang, dan organ internal lainnya dengan cepat dan akurat.",
            "fragment": "ctscan",
            "link": "rsroemani/index.html#ctscan",
            "sceneId": "node29"
        },
        {
            "infoId": 193,
            "label": "ESWL",
            "description": "Fasilitas ESWL (Extracorporeal Shock Wave Lithotripsy) di RS Roemani Semarang adalah layanan unggulan di bidang Urologi untuk pemecahan batu saluran kemih (ginjal, ureter, atau kandung kemih) tanpa melalui tindakan pembedahan (operasi). Prosedur non-invasif ini menggunakan gelombang kejut yang diarahkan dari luar tubuh untuk menghancurkan batu menjadi serpihan kecil agar dapat dikeluarkan secara alami bersama urine, sehingga pasien tidak perlu rawat inap lama.",
            "fragment": "ewsl",
            "link": "rsroemani/index.html#ewsl",
            "sceneId": "node30"
        },
        {
            "infoId": 194,
            "label": "Ruang Operasi",
            "description": "Fasilitas ruang operasi di RS Roemani Semarang didukung oleh Pelayanan Anestesiologi dan Bedah (PAB) serta Pelayanan Tindakan Khusus untuk berbagai spesialisasi, termasuk Bedah Umum, Kebidanan, dan Urologi. Ruang operasi ini dilengkapi dengan peralatan medis modern untuk menjamin keselamatan pasien dan mendukung prosedur bedah minimal invasif.",
            "fragment": "ruangoperasi",
            "link": "rsroemani/index.html#ruangoperasi",
            "sceneId": "node31"
        }
    ],
