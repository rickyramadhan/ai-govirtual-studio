    "objects": [
        {
            "infoId": 382,
            "label": "Aula Graha Semesta",
            "description": "Aula Graha Semesta berfungsi sebagai auditorium atau ruang pertemuan besar untuk menampung berbagai acara formal dan kegiatan sekolah. Tempat ini menjadi pusat kegiatan komunitas sekolah, mulai dari upacara hingga pertunjukan seni atau seminar.",
            "fragment": "aula",
            "link": "boardingschool/index.html#aula",
            "sceneId": "node84"
        },
        {
            "infoId": 383,
            "label": "Lab IPA",
            "description": "Lab IPA (Biologi) Sekolah ini memiliki laboratorium sains terpisah untuk Fisika, Kimia, dan Biologi yang mendukung kurikulum internasional. Laboratorium ini dilengkapi dengan peralatan modern untuk memfasilitasi praktikum dan persiapan siswa dalam olimpiade sains.",
            "fragment": "labipa",
            "link": "boardingschool/index.html#labipa",
            "sceneId": "node95"
        },
        {
            "infoId": 384,
            "label": "Lab Komputer",
            "description": "Lab Komputer menyediakan fasilitas teknologi digital untuk mendukung model pembelajaran Technology Integrated Classroom. Ruangan ini digunakan siswa untuk praktik komputasi dan riset berbasis teknologi sebagai bagian dari kurikulum.",
            "fragment": "labkomputer",
            "link": "boardingschool/index.html#labkomputer",
            "sceneId": "node97"
        },
        {
