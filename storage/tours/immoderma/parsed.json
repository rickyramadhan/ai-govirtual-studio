    "objects": [
        {
            "infoId": 1145,
            "label": "Ruang Perawatan",
            "description": "Ruang Perawatan (Treatment Room) di Imoderna Aesthetic & Skin Care Clinic Semarang merupakan pusat tindakan medis estetika yang dirancang untuk efisiensi alur kerja tenaga medis sekaligus kenyamanan maksimal bagi pasien. Ruangan ini menggunakan sistem open-ward dengan sekat tirai yang memungkinkan fleksibilitas penggunaan ruang; tirai dapat ditutup rapat untuk menjamin privasi selama tindakan laser atau facial, namun tetap memudahkan mobilitas staf klinis antar-bed.",
            "fragment": "ruangperawatan",
            "link": "immoderma/index.html#ruangperawatan",
            "sceneId": "node4"
        },
        {
            "infoId": 1146,
            "label": "Ruang Tindakan",
            "description": "Ruangan ini dirancang untuk memberikan pengalaman perawatan yang privat dan nyaman, sesuai dengan standar layanan Imoderma yang mengedepankan profesionalitas dalam lingkungan yang suportif bagi kesehatan kulit dan kesejahteraan diri.",
            "fragment": "ruangtindakan",
            "link": "immoderma/index.html#ruangtindakan",
            "sceneId": "node3"
        },
        {
            "infoId": 1147,
            "label": "Ruang Perawatan Khusus",
            "description": "Ruangan ini dirancang sebagai area multifungsi yang mampu menangani berbagai prosedur, mulai dari perawatan kulit wajah dasar hingga tindakan medis tingkat lanjut menggunakan teknologi laser.",
            "fragment": "ruangperawatankhusus",
            "link": "immoderma/index.html#ruangperawatankhusus",
            "sceneId": "node5"
        },
        {
            "infoId": 1148,
            "label": "Resepsionis",
            "description": "Area ini menjadi titik tunggal untuk pendaftaran, manajemen janji temu (appointment), hingga transaksi pembayaran (kasir), sehingga alur kunjungan pasien menjadi lebih efisien dan terorganisir.",
            "fragment": "receptionist",
            "link": "immoderma/index.html#receptionist",
            "sceneId": "node10"
        }
    ],
