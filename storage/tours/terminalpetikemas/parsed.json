    "objects": [
        {
            "infoId": 935,
            "label": "Stacking Yard",
            "description": "Tumpukan Peti Kemas (Stacking Yard) merupakan area lapangan penumpukan tempat berbagai peti kemas dari maskapai pelayaran internasional seperti MAERSK, EVERGREEN, KMTC, COSCO SHIPPING, dan SAMUDERA disusun rapi sambil menunggu proses pemuatan ke kapal atau pengiriman kepada pemilik barang.",
            "fragment": "stacking-yard",
            "link": "petikemas/index.html#stacking-yard",
            "sceneId": "node1"
        },
        {
            "infoId": 936,
            "label": "Gerbang",
            "description": "Gerbang masuk utama atau gate TPK Semarang (Terminal Peti Kemas Semarang) berfungsi sebagai titik kontrol utama bagi truk pengangkut kontainer yang masuk dan keluar area pelabuhan. Area ini dilengkapi dengan beberapa lajur pemeriksaan yang memiliki rambu peringatan serta batas ketinggian kendaraan.",
            "fragment": "gerbang",
            "link": "petikemas/index.html#gerbang",
            "sceneId": "node8"
        },
        {
            "infoId": 937,
            "label": "Dermaga",
            "description": "Dermaga TPKS Semarang memiliki panjang sekitar 495 hingga 600 meter. Peralatan utama yang beroperasi di sisi dermaga seperti STS (Ship-to-Shore) Crane atau Container Crane merupakan derek raksasa yang berfungsi memindahkan peti kemas dari palka kapal ke truk dermaga atau sebaliknya. TPKS mengoperasikan beberapa unit STS Crane bertenaga listrik yang ramah lingkungan.",
            "fragment": "dermaga",
            "link": "petikemas/index.html#dermaga",
            "sceneId": "node6"
        }
    ],
