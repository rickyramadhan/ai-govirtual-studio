    "objects": [
        {
            "infoId": 1065,
            "label": "Ruang Karaoke",
            "description": "Fasilitas Ruang Karaoke di Akhtara Skyview Semarang hadir sebagai zona hiburan privat eksklusif yang melengkapi pengalaman bersantai di kafe ini, membedakannya dari sekadar tempat makan biasa. Ruangan ini didesain terpisah dari area dining publik untuk menjamin privasi maksimal dan akustik yang tidak mengganggu pengunjung lain, dilengkapi dengan interior yang nyaman, pendingin ruangan (AC), serta sistem audio dan visual yang mumpuni untuk aktivitas bernyanyi.",
            "fragment": "ruangkaraoke",
            "link": "akhtaracoffee/index.html#ruangkaraoke",
            "sceneId": "node11"
        },
        {
            "infoId": 1066,
            "label": "Area Dining Lt.1",
            "description": "Area dining di lantai 1 Akhtara Skyview dirancang sebagai zona akses utama yang aksesibilitasnya ramah bagi semua usia, sangat cocok untuk keluarga yang membawa lansia atau balita karena tidak perlu menaiki tangga untuk mencapai tempat duduk. Selain itu, karena lokasinya yang berdekatan dengan coffee bar dan kasir, pelayanan di area ini cenderung lebih cepat dan responsif.",
            "fragment": "areadininglt1",
            "link": "akhtaracoffee/index.html#areadininglt1",
            "sceneId": "node5"
        },
        {
            "infoId": 1067,
            "label": "Area Dining Lt.2",
            "description": "Area dining lantai 2 di Akhtara Skyview menawarkan konsep semi-outdoor yang lebih terbuka dan dinamis, menjadikannya \"jantung\" kehidupan sosial di kafe ini, terutama bagi kalangan muda. Berada di ketinggian yang lebih strategis, lantai ini dirancang untuk memaksimalkan pengalaman visual, di mana pengunjung dapat menikmati panorama hamparan hijau Gunung Pati dan kelap-kelip lampu kota (city lights) Semarang dengan lebih leluasa tanpa terhalang dinding tertutup.",
            "fragment": "areadininglt2",
            "link": "akhtaracoffee/index.html#areadininglt2",
            "sceneId": "node9"
        },
        {
            "infoId": 1068,
            "label": "Area Dining Lt.3",
            "description": "Area dining lantai 3, yang difungsikan sebagai area Rooftop terbuka, merupakan daya tarik visual utama dan lantai tertinggi di Akhtara Skyview. Suasana di area ini sangat atmospheric dan romantis, didukung oleh hembusan angin dataran tinggi yang sejuk, menjadikannya spot paling populer bagi pemburu foto instagramable dan pasangan yang ingin menikmati momen makan malam di bawah langit terbuka.",
            "fragment": "areadininglt3",
            "link": "akhtaracoffee/index.html#areadininglt3",
            "sceneId": "node3"
        }
    ],
