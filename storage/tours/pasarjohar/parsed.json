    "objects": [
        {
            "infoId": 1175,
            "label": "Area Pasar Utara",
            "description": "Bagian ini difungsikan sebagai pusat aktivitas perdagangan yang didominasi oleh pedagang bahan pangan dan kebutuhan pokok sehari-hari. Bangunannya memiliki ciri khas arsitektur yang megah dengan sirkulasi udara yang dirancang agar tetap sejuk bagi pengunjung.",
            "fragment": "areapasarutara",
            "link": "pasarjohar/index.html#areapasarutara",
            "sceneId": "node2"
        },
        {
            "infoId": 1176,
            "label": "Area Pasar Tengah",
            "description": "Wilayah ini menjadi penghubung utama yang menampung beragam komoditas seperti pakaian, tekstil, dan perlengkapan rumah tangga. Fokus utama area ini adalah menyediakan pengalaman belanja yang teratur bagi masyarakat yang mencari produk sandang berkualitas.",
            "fragment": "areapasartengah",
            "link": "pasarjohar/index.html#areapasartengah",
            "sceneId": "node7"
        },
        {
            "infoId": 1177,
            "label": "Area Pasar Selatan",
            "description": "Area ini umumnya diperuntukkan bagi pedagang produk-produk spesifik termasuk pusat oleh-oleh dan barang-barang tradisional. Penataannya dibuat sedemikian rupa agar memudahkan akses bagi pengunjung yang ingin mencari barang dengan kategori tertentu secara lebih fokus.",
            "fragment": "areapasarselatan",
