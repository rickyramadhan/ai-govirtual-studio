    "objects": [
        {
            "infoId": 489,
            "label": "Pelayanan Pelanggan",
            "description": "Stasiun Poncol memiliki loket fisik dan mesin tiket mandiri untuk melayani penumpang, serta tersedia loket informasi dan lost-and-found untuk membantu penumpang terkait perjalanan dan barang hilang. Fasilitas ini memastikan penumpang dapat dengan mudah membeli tiket, memperoleh informasi, dan menyelesaikan masalah.",
            "fragment": "pelayananpelanggan",
            "link": "poncol/index.html#pelayananpelanggan",
            "sceneId": "node3"
        },
        {
            "infoId": 491,
            "label": "Ruang Menyusui",
            "description": "Stasiun Poncol menyediakan ruang laktasi yang tertutup (privat) untuk kenyamanan ibu yang membawa bayi atau balita. Ruangan ini terletak tidak jauh dari ruang tunggu utama, memastikan privasi dan kemudahan akses bagi ibu menyusui.",
            "fragment": "ruangmenyusui",
            "link": "poncol/index.html#ruangmenyusui",
            "sceneId": "node11"
        },
        {
            "infoId": 492,
            "label": "Lobby Keberangkatan",
            "description": "Lobi keberangkatan berfungsi sebagai area sentral untuk proses check-in dan boarding penumpang sebelum menuju peron. Stasiun Poncol telah mengimplementasikan teknologi Face Recognition Boarding Gate di area ini, yang memungkinkan penumpang KA Jarak Jauh hanya perlu memindai wajah (setelah registrasi) tanpa menunjukkan tiket fisik atau KTP.",
            "fragment": "lobbykeberangkatan",
            "link": "poncol/index.html#lobbykeberangkatan",
            "sceneId": "node4"
        }
    ],
