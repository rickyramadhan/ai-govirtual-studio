    "objects": [
        {
            "infoId": 177,
            "label": "Ruang Konsultasi",
            "description": "Ruang ini adalah tempat pertama pasien bertemu dengan dokter profesional untuk mendiskusikan keluhan kulit dan tujuan estetika yang diinginkan. Di sinilah dokter akan menganalisis kondisi kulit secara mendalam dan merekomendasikan jenis perawatan yang paling sesuai sebelum tindakan dilakukan.",
            "fragment": "",
            "link": "dermaexpress/index.html#",
            "sceneId": ""
        },
        {
            "infoId": 178,
            "label": "Receptionist",
            "description": "Area receptionist adalah bagian depan klinik yang berfungsi sebagai pusat informasi, pendaftaran, dan administrasi bagi setiap pasien. Staf di area ini bertanggung jawab untuk menyambut pasien, mengarahkan proses konsultasi, serta mengatur jadwal tindakan perawatan.",
            "fragment": "receptionist",
            "link": "dermaexpress/index.html#receptionist",
            "sceneId": "node10"
        },
        {
            "infoId": 179,
            "label": "Ruang Perawatan Contouring",
            "description": "Area ini secara umum merujuk pada ruang tindakan yang dikhususkan untuk prosedur contouring seperti filler atau botox, bertujuan membentuk proporsi wajah sesuai keinginan pasien. Ruangan ini dilengkapi dengan peralatan steril dan memadai untuk memastikan tindakan estetika berjalan aman dan presisi di bawah pengawasan dokter.",
            "fragment": "ruangcontouring",
            "link": "dermaexpress/index.html#ruangcontouring",
            "sceneId": "node3"
        },
        {
            "infoId": 180,
            "label": "Ruang VIP",
            "description": "Ruang VIP adalah fasilitas eksklusif yang disediakan bagi pasien yang menginginkan pengalaman perawatan dengan privasi dan kenyamanan maksimal. Ruangan ini menawarkan suasana yang lebih privat dan tenang, ideal untuk menjalani tindakan tanpa gangguan dari pasien lain.",
            "fragment": "",
            "link": "dermaexpress/index.html#",
            "sceneId": ""
        },
        {
            "infoId": 181,
            "label": "Ruang Skin Treatment",
            "description": "Ruangan ini adalah tempat utama dilakukannya berbagai tindakan perawatan kulit dan estetika, mulai dari facial, laser, hingga filler dan botox. Semua ruangan tindakan di Derma Express dirancang rapi, bersih, dan dilengkapi dengan peralatan medis berteknologi tinggi untuk memastikan keamanan dan efektivitas perawatan.",
            "fragment": "ruangtreatment",
            "link": "dermaexpress/index.html#ruangtreatment",
            "sceneId": "node2"
        }
    ],
