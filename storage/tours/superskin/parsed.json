    "objects": [
        {
            "infoId": 419,
            "label": "Ruang Laser",
            "description": "Ruangan ini adalah area khusus yang dilengkapi dengan berbagai perangkat teknologi laser canggih, untuk mengatasi berbagai masalah kulit seperti pigmentasi, flek hitam, dan peremajaan kulit. Ruang laser menjamin tindakan dilakukan secara presisi dan aman oleh tenaga ahli untuk memberikan hasil yang optimal bagi kulit.",
            "fragment": "ruanglaser",
            "link": "superskin/index.html#ruanglaser",
            "sceneId": "node21"
        },
        {
            "infoId": 420,
            "label": "Ruang Perawatan",
            "description": "Ini adalah ruangan tindakan umum di mana pasien menjalani berbagai prosedur estetika seperti facial, peeling, hingga perawatan non-invasif lainnya. Ruangan ini dirancang bersih dan nyaman untuk memberikan pengalaman relaksasi sekaligus perawatan kulit secara menyeluruh.",
            "fragment": "ruangperawatan",
            "link": "superskin/index.html#ruangperawatan",
            "sceneId": "node11"
        },
        {
            "infoId": 1149,
            "label": "Ruang Konsultasi",
            "description": "Ruangan konsultasi adalah tempat penting di mana pasien bertemu langsung dengan dokter profesional untuk mendiskusikan keluhan kulit mereka. Dokter akan melakukan pemeriksaan dan memberikan rekomendasi perawatan yang paling tepat berdasarkan kondisi kulit individu pasien.",
            "fragment": "ruangkonsultasi",
            "link": "superskin/index.html#ruangkonsultasi",
            "sceneId": "node19"
        },
        {
            "infoId": 1150,
            "label": "Resepsionis",
            "description": "Area receptionist merupakan bagian depan klinik yang menjadi pusat pelayanan pertama bagi setiap pengunjung, bertugas menyambut dan melayani pendaftaran. Staf di area ini akan membantu pasien dalam proses check-in, mengatur jadwal konsultasi, dan mengarahkan mereka ke fasilitas selanjutnya.",
            "fragment": "ruangresepsionis",
            "link": "superskin/index.html#ruangresepsionis",
            "sceneId": "node9"
        }
    ],
