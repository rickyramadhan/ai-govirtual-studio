    "objects": [
        {
            "infoId": 514,
            "label": "Lobby",
            "description": "Lobi utama Mall Paragon berfungsi sebagai area pintu masuk dan pusat informasi bagi pengunjung. Area ini biasanya lapang dan menjadi titik temu penting, sering kali digunakan sebagai lokasi pameran atau acara promosi.",
            "fragment": "lobby",
            "link": "polluxmall/index.html#lobby",
            "sceneId": "node90"
        },
        {
            "infoId": 515,
            "label": "Matahari",
            "description": "Matahari adalah salah satu departemen store besar yang menjadi penyewa utama di Mall Paragon. Toko ini menawarkan berbagai produk mulai dari pakaian, kosmetik, hingga perlengkapan rumah tangga untuk memenuhi kebutuhan belanja fashion dan sehari-hari.",
            "fragment": "matahari",
            "link": "polluxmall/index.html#matahari",
            "sceneId": "node82"
        },
        {
            "infoId": 516,
            "label": "Hypermart",
            "description": "Hypermart adalah pusat belanja kebutuhan sehari-hari (grocery store) yang besar dan lengkap di dalam mall. Tempat ini menyediakan berbagai macam produk segar, makanan kemasan, dan perlengkapan rumah tangga dalam skala supermarket.",
            "fragment": "hypermart",
            "link": "polluxmall/index.html#hypermart",
            "sceneId": "node101"
        },
        {
            "infoId": 517,
            "label": "Happy Time",
            "description": "Happy Time adalah area pusat hiburan dan permainan (Timezone) di dalam mall, sering kali berlokasi di lantai atas. Tempat ini menyediakan berbagai mesin permainan dan wahana yang cocok untuk keluarga dan anak-anak.",
            "fragment": "happytime",
            "link": "polluxmall/index.html#happytime",
            "sceneId": "node105"
        },
        {
            "infoId": 518,
            "label": "Celebrity Fitness",
            "description": "Celebrity Fitness adalah pusat kebugaran premium yang berlokasi di Pollux Mall Paragon Semarang, umumnya berada di lantai 3 (L3). Gym ini menyediakan berbagai fasilitas modern seperti area kardio, weights area, studio khusus untuk kelas yoga dan cycling, hingga fasilitas pendukung seperti ruang sauna dan lounge anggota.",
            "fragment": "celebrityfitness",
            "link": "polluxmall/index.html#celebrityfitness",
            "sceneId": "node83"
        },
        {
