    "objects": [
        {
            "infoId": 533,
            "label": "Farmers Market",
            "description": "Farmers Market adalah tenant supermarket di Mall Tentrem yang menyediakan berbagai kebutuhan harian, mulai dari buah, sayuran, daging, seafood, hingga produk dairy dan frozen food dengan fokus pada kualitas dan kesegaran. Pasar modern ini menjamin produk makanan yang sehat, aman, dan memuaskan bagi pelanggan.",
            "fragment": "farmersmarket",
            "link": "tentremmall/index.html#farmersmarket",
            "sceneId": "node91"
        },
        {
            "infoId": 534,
            "label": "South Lobby",
            "description": "South Lobby adalah salah satu akses masuk utama Mall Tentrem, yang berfungsi sebagai titik awal bagi pengunjung untuk masuk ke area perbelanjaan dan terhubung dengan mixed-use building lainnya. Area lobi ini juga sering menjadi lokasi penting untuk pick-up point atau area informasi.",
            "fragment": "southlobby",
            "link": "tentremmall/index.html#southlobby",
            "sceneId": "node80"
        },
        {
            "infoId": 535,
            "label": "Summer Palace",
            "description": "Summer Palace sebenarnya adalah restoran Chinese fine dining mewah yang berlokasi di Hotel Tentrem, bukan di dalam Mall Tentrem, meskipun keduanya terhubung. Restoran ini menyajikan hidangan oriental dengan cita rasa premium, menawarkan pengalaman kuliner yang elegan bagi tamu hotel dan pengunjung.",
            "fragment": "summerpalace",
            "link": "tentremmall/index.html#summerpalace",
            "sceneId": "node81"
        },
        {
            "infoId": 536,
            "label": "Main Atrium",
            "description": "Main Atrium adalah area utama di pusat mal yang paling ikonik karena menampilkan videotron langit-langit terpanjang di Indonesia. Videotron ini sering menampilkan visual 3D yang memukau, seperti suasana bawah laut (hiu dan paus), yang menjadi daya tarik utama Mall Tentrem.",
            "fragment": "atrium",
            "link": "tentremmall/index.html#atrium",
            "sceneId": "node93"
        },
        {
            "infoId": 537,
            "label": "Akuarium",
            "description": "Aquarium adalah fasilitas aquarium berukuran besar yang menampung berbagai spesies jenis ikan air laut.",
            "fragment": "akuarium",
            "link": "tentremmall/index.html#akuarium",
            "sceneId": "node86"
        }
