    "objects": [
        {
            "infoId": 116,
            "label": "Auditorium",
            "description": "Fasilitas ini merupakan tempat berkumpul, pementasan, maupun penampilan beberapa pagelaran seni dan budaya, maupun sekadar meeting point pengunjung di Waduk Kandri. Auditorium ini merupakan salah satu sarana prasarana umum penting yang mendukung aktivitas masyarakat lokal dan acara kepariwisataan di Desa Wisata Kandri.",
            "fragment": "auditorium",
            "link": "desakandri/index.html#auditorium",
            "sceneId": "node153"
        },
        {
            "infoId": 117,
            "label": "Kantor Desa Wisata Kandri",
            "description": "Kantor & Sekretariat Pengelola Desa Wisata Kandri merupakan pusat administrasi yang menjadi bagian dari sarana dan prasarana penunjang pariwisata. Tempat ini biasa menjadi titik kumpul wisatawan di Desa Wisata Kandri maupun sekadar sebagai sumber informasi objek wisata yang ada di Kandri.",
            "fragment": "kantordesa",
            "link": "desakandri/index.html#kantordesa",
            "sceneId": "node146"
        },
        {
            "infoId": 118,
            "label": "Omah Alas",
            "description": "Omah Alas di Desa Wisata Kandri adalah sebuah sanggar seni yang menjadi pusat kebudayaan dan kesenian lokal, seperti gamelan, karawitan, dan tari tradisional. Tempat ini juga difungsikan sebagai area edukasi dan rekreasi yang mengangkat kembali permainan tradisional atau dolanan bocah di tengah suasana alam yang sejuk.",
            "fragment": "omahalas",
            "link": "desakandri/index.html#omahalas",
            "sceneId": "node139"
        },
        {
            "infoId": 119,
            "label": "Sendang Gede",
            "description": "Sendang Gede di Desa Wisata Kandri berfungsi sebagai sumber mata air utama untuk kebutuhan masyarakat serta objek daya tarik wisata budaya karena menjadi lokasi diselenggarakannya prosesi adat Nyadran Sendang/Kali.",
            "fragment": "sendanggede",
            "link": "desakandri/index.html#sendanggede",
            "sceneId": "node149"
        }
    ],
