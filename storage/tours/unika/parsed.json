    "objects": [
        {
            "infoId": 1085,
            "label": "Fakultas Psikologi (UNIKA)",
            "description": "Fakultas Psikologi Universitas Katolik Soegijapranata (SCU) merupakan salah satu pilar pendidikan psikologi terkemuka di Jawa Tengah yang telah meraih akreditasi Unggul. Berlokasi di lingkungan Kampus Bendan Dhuwur yang rindang dan asri, fakultas ini memadukan fasilitas akademik modernâ€”seperti laboratorium psikodiagnostik dan pusat layanan psikologi terapanâ€”dengan arsitektur gedung yang ikonik dan ramah lingkungan.",
            "fragment": "fakultaspsikologi",
            "link": "unika/index.html#fakultaspsikologi",
            "sceneId": "node353"
        },
        {
            "infoId": 1086,
            "label": "Gereja Santo Mikael (UNIKA)",
            "description": "Gereja ini merupakan jantung spiritual bagi universitas yang membawa nama Monsinyur Albertus Soegijapranata. Selain digunakan untuk misa rutin, tempat ini sering menjadi lokasi upacara inisiasi mahasiswa baru serta misa pelepasan wisudawan.",
            "fragment": "gerejasantomikael",
            "link": "unika/index.html#gerejasantomikael",
            "sceneId": "node331"
        },
        {
            "infoId": 1087,
            "label": "Museum Soegijapranata (UNIKA)",
            "description": "Museum Soegijapranata yang terletak di lingkungan kampus Universitas Katolik (Unika) Soegijapranata, Semarang. Ruangan ini dirancang sebagai ruang memori untuk menghormati dan melestarikan warisan sejarah dari Monsinyur Albertus Soegijapranata, uskup pribumi pertama di Indonesia sekaligus pahlawan nasional yang namanya diabadikan sebagai nama universitas tersebut.",
            "fragment": "museumsoegijapranata",
            "link": "unika/index.html#museumsoegijapranata",
            "sceneId": "node357"
        },
        {
            "infoId": 1088,
            "label": "Gedung Albertus (UNIKA)",
            "description": "Gedung Albertus (UNIKA) adalah salah satu bangunan utama milik Universitas Katolik Soegijapranata di Semarang. Gedung ini digunakan untuk kegiatan akademik seperti perkuliahan dan administrasi. Namanya diambil dari Santo Albertus sebagai simbol nilai intelektualitas dan integritas dalam pendidikan.",
            "fragment": "gedungalbertus",
            "link": "unika/index.html#gedungalbertus",
            "sceneId": "node338"
        },
        {
            "infoId": 1089,
            "label": "Ruang Kelas (UNIKA)",
            "description": "Smart Classroom atau ruang kelas modern di Universitas Katolik Soegijapranata (SCU/Unika), Semarang. Ruangan ini dirancang dengan konsep ergonomis dan teknologi terintegrasi untuk mendukung metode pembelajaran aktif (active learning). Fokus utama ruangan adalah layar monitor besar di bagian depan yang dikelilingi oleh panel kayu minimalis, memberikan kesan profesional dan bersih.",
            "fragment": "ruangkelasunika",
            "link": "unika/index.html#ruangkelasunika",
            "sceneId": "node344"
        },
        {
            "infoId": 1090,
            "label": "Perpustakaan (UNIKA)",
            "description": "Perpustakaan Universitas Katolik (Unika) Soegijapranata Semarang, yang dikenal dengan suasana belajarnya yang tenang dan modern. Area ini berfungsi sebagai pusat layanan dan interaksi, terlihat dari adanya meja resepsionis atau sirkulasi di sisi kiri yang melengkung, serta beberapa fasilitas pendukung seperti rak buku pajangan, loker penyimpanan barang di sisi kanan, dan drop box pengembalian buku mandiri.",
            "fragment": "perpustakaanunika",
            "link": "unika/index.html#perpustakaanunika",
            "sceneId": "node359"
        },
        {
            "infoId": 1091,
            "label": "Lab Komputer (BSB UNIKA)",
            "description": "Keberadaan laboratorium ini di Kampus BSB Unika mencerminkan integrasi antara akademisi dan kebutuhan industri. Fasilitas ini memungkinkan terjadinya link and match, di mana mahasiswa terbiasa menggunakan standar perangkat keras yang sama dengan yang digunakan di dunia profesional, sehingga saat lulus mereka sudah siap pakai (industry-ready).",
            "fragment": "labkomputerbsb",
            "link": "unika/index.html#labkomputerbsb",
            "sceneId": "node367"
        },
        {
            "infoId": 1092,
            "label": "Perpustakaan (BSB UNIKA)",
            "description": "Perpustakaan ini merupakan cerminan dari konsep Smart Campus. Dengan adanya fasilitas digital dan integrasi sistem perpustakaan pusat, mahasiswa di BSB tetap memiliki hak akses yang setara terhadap sumber daya global, yang mendukung standar akreditasi dan kualitas riset mahasiswa.",
            "fragment": "perpustakaanbsb",
            "link": "unika/index.html#perpustakaanbsb",
            "sceneId": "node374"
        },
        {
            "infoId": 1093,
            "label": "Ruang Kelas (BSB UNIKA)",
            "description": "Keberadaan layar monitor besar di samping papan tulis menunjukkan bahwa ruang ini siap untuk pembelajaran Blended Learning. Dosen tidak hanya terpaku pada materi tekstual di papan tulis, tetapi juga dapat memvisualisasikan konsep kompleks melalui konten multimedia, yang sangat krusial bagi generasi mahasiswa digital native.",
            "fragment": "ruangkelasbsb",
            "link": "unika/index.html#ruangkelasbsb",
            "sceneId": "node361"
        },
        {
            "infoId": 1094,
            "label": "Laboratorium (BSB UNIKA)",
            "description": "Laboratorium di Unika Soegijapranata (SCU) Kampus BSB City ini merupakan fasilitas Edu-Teknopark yang dirancang sebagai pusat pembelajaran praktis dan inovasi teknologi pangan. Secara edukatif, ruangan ini berfungsi sebagai jembatan antara teori akademis dan implementasi industri bagi mahasiswa, khususnya dalam memahami alur produksi serta penjaminan mutu produk secara komprehensif.",
            "fragment": "laboratoriumbsb",
            "link": "unika/index.html#laboratoriumbsb",
            "sceneId": "node368"
        },
        {
            "infoId": 1095,
            "label": "Auditorium (BSB UNIKA)",
            "description": "Fasilitas auditorium atau ruang teater modern yang berada di gedung BSB (Beato Sugijapranata Building), Universitas Katolik (Unika) Soegijapranata, Semarang. Ruangan ini dirancang dengan estetika yang sangat hangat dan kontemporer, didominasi oleh elemen kayu pada lantai dan panel dindingnya untuk menciptakan akustik yang baik sekaligus kesan mewah. Sebagai bagian dari gedung BSB yang menjadi ikon baru kampus, ruang ini mencerminkan komitmen universitas dalam menyediakan fasilitas belajar yang representatif dan nyaman bagi civitas akademika.",
            "fragment": "auditoriumbsb",
            "link": "unika/index.html#auditoriumbsb",
            "sceneId": "node376"
        },
        {
            "infoId": 1096,
            "label": "Sport Hall (BSB UNIKA)",
            "description": "Sport Hall atau gedung olahraga indoor yang terletak di kampus Unika Soegijapranata (SCU) BSB City, Semarang. Ruangan ini dirancang dengan konsep modern dan multifungsi, terlihat dari ketersediaan beberapa lapangan sekaligus dalam satu area besar, yakni lapangan futsal dengan lantai biru di sisi kiri serta beberapa lapangan bulu tangkis beralas hijau di sisi kanan. Gedung ini memiliki struktur atap melengkung yang tinggi dengan rangka baja ekspos yang memberikan kesan luas dan sirkulasi udara yang baik.",
            "fragment": "sporthallbsb",
            "link": "unika/index.html#sporthallbsb",
            "sceneId": "node370"
        }
    ],
