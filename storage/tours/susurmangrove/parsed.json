    "objects": [
        {
            "infoId": 695,
            "label": "Dermaga",
            "description": "Dermaga di kawasan wisata Mangrove Desa Tapak, Tugurejo, berfungsi sebagai gerbang utama sekaligus titik sentral dimulainya eksplorasi menyusuri ekosistem pesisir Semarang. Lebih dari sekadar tempat menambatkan perahu, dermaga ini menjadi zona transisi vital yang menghubungkan area daratan desa dengan jalur perairan Sungai Tapak yang mengarah ke hutan bakau dan laut lepas.",
            "fragment": "dermaga",
            "link": "susurmangrove/index.html#dermaga",
            "sceneId": "node86"
        },
        {
            "infoId": 696,
            "label": "Area Pembenihan Ikan",
            "description": "Area pembenihan ikan di kawasan wisata Susur Mangrove Desa Tapak, Tugurejo, merupakan representasi nyata dari penerapan sistem Silvofishery atau Wanamina, sebuah metode budidaya yang mengintegrasikan tambak perikanan dengan kelestarian hutan bakau dalam satu kawasan.",
            "fragment": "areapembenihan",
            "link": "susurmangrove/index.html#areapembenihan",
            "sceneId": "node87"
        },
        {
            "infoId": 697,
            "label": "Papan Pemberitahuan Pemerintah Kota Semarang",
            "description": "Papan ini berfungsi sebagai peringatan hukum agar kawasan konservasi bakau dan aliran sungai tersebut tidak disalahgunakan (misalnya untuk bangunan ilegal atau pembuangan sampah) yang dapat merusak ekosistem pengendali banjir di Semarang.",
            "fragment": "pemberitahuan",
            "link": "susurmangrove/index.html#pemberitahuan",
            "sceneId": "node84"
        }
