    "objects": [
        {
            "infoId": 908,
            "label": "Jembatan Kaca",
            "description": "Jembatan Kaca Tinjomoyo merupakan ikon wisata baru di Semarang yang menawarkan sensasi berjalan di atas ketinggian 20 meter dengan lantai kaca transparan sepanjang 64 meter. Destinasi pemacu adrenalin ini menyuguhkan pemandangan asri lembah sungai dan hutan Tinjomoyo yang hijau dari sudut pandang yang unik dan modern.",
            "fragment": "jembatankaca",
            "link": "tinjomoyo/index.html#jembatankaca",
            "sceneId": "node5"
        },
        {
            "infoId": 909,
            "label": "Pasar Semarangan",
            "description": "Pasar Semarangan di Hutan Wisata Tinjomoyo adalah destinasi wisata kuliner bertema digital yang menyajikan berbagai jajanan tradisional di tengah suasana hutan pinus yang asri. Keunikan pasar ini terletak pada sistem pembayarannya yang eksklusif menggunakan transaksi nontunai atau aplikasi digital guna mendukung gaya hidup modern yang ramah lingkungan.",
            "fragment": "pasarsemarangan",
            "link": "tinjomoyo/index.html#pasarsemarangan",
            "sceneId": "node9"
        }
