    "objects": [
        {
            "infoId": 1130,
            "label": "Laboratorium",
            "description": "Laboratorium RS Columbia Asia Semarang merupakan fasilitas penunjang medis modern yang beroperasi selama 24 jam untuk memberikan pelayanan diagnostik yang akurat dan efisien. Didukung oleh teknologi otomatisasi mutakhir dan tenaga ahli profesional, laboratorium ini mampu melayani berbagai kebutuhan pemeriksaan mulai dari patologi klinik hingga mikrobiologi dengan standar keamanan pasien yang tinggi.",
            "fragment": "laboratorium",
            "link": "rscolumbiaasia/index.html#laboratorium",
            "sceneId": "node97"
        },
        {
            "infoId": 1131,
            "label": "Kateterisasi Laboratorium",
            "description": "Ruangan ini merupakan unit layanan medis canggih yang khusus digunakan untuk melakukan prosedur diagnostik dan intervensi invasif minimal pada pembuluh darah, jantung, dan otak. Dilengkapi dengan teknologi pemindaian sinar-X real-time (C-Arm) yang terlihat dominan di tengah ruangan, fasilitas ini memungkinkan dokter spesialis untuk melihat struktur organ bagian dalam secara mendetail tanpa perlu melakukan bedah terbuka yang besar.",
            "fragment": "cathlab",
            "link": "rscolumbiaasia/index.html#cathlab",
            "sceneId": "node98"
        },
        {
            "infoId": 1132,
            "label": "CT Scan",
            "description": "Di pusat ruangan terdapat unit mesin CT Scan modern dengan desain gantry berbentuk cincin besar dan meja pemeriksaan yang dapat bergerak secara otomatis untuk memposisikan pasien masuk ke dalam pemindai. Teknologi ini sangat krusial untuk menghasilkan pencitraan medis yang detail, memungkinkan dokter mendiagnosis berbagai kondisi internal tubuh mulai dari cedera kepala, gangguan organ dalam, hingga deteksi dini tumor dengan akurasi tinggi dan waktu pemindaian yang relatif cepat.",
            "fragment": "ctscan",
            "link": "rscolumbiaasia/index.html#ctscan",
            "sceneId": "node80"
        },
        {
            "infoId": 1133,
            "label": "Ruang Bersalin",
            "description": "Salah satu ruang tindakan medis di Rumah Sakit Columbia Asia Semarang, yang dirancang dengan standar kenyamanan dan sterilitas tinggi. Ruangan ini tampak difungsikan sebagai ruang bersalin atau ruang tindakan kebidanan, terlihat dari adanya tempat tidur pemeriksaan ginekologi multifungsi di bagian tengah serta peralatan medis pendukung di sekitarnya.",
            "fragment": "ruangbersalin",
            "link": "rscolumbiaasia/index.html#ruangbersalin",
            "sceneId": "node85"
        },
        {
            "infoId": 1134,
            "label": "X Ray",
            "description": "Fasilitas ini merupakan bagian dari layanan penunjang medis di RS Columbia Asia Semarang yang mendukung diagnosis cepat dan akurat bagi pasien rawat inap maupun rawat jalan. Unit sinar-X statis yang digunakan untuk mendiagnosis berbagai kondisi medis melalui pencitraan struktur tulang maupun organ dalam.",
            "fragment": "xray",
            "link": "rscolumbiaasia/index.html#xray",
            "sceneId": "node96"
        },
        {
            "infoId": 1135,
            "label": "Ruang Operasi",
            "description": "Fasilitas Kamar Operasi (OK) yang modern dan komprehensif di RS Columbia Asia Semarang. Ruangan ini telah memenuhi standar medis internasional dengan mengintegrasikan sistem filtrasi udara steril (Laminar Air Flow), pencahayaan shadowless yang presisi, serta peralatan anestesi dan pemantauan pasien yang canggih. Ruangan ini dirancang dengan standar sterilitas tinggi dan teknologi medis mutakhir untuk mendukung berbagai prosedur pembedahan.",
            "fragment": "operationroom",
            "link": "rscolumbiaasia/index.html#operationroom",
            "sceneId": "node92"
        },
        {
            "infoId": 1194,
            "label": "Kamar Rawat Inap\\r\\n",
            "description": "fasilitas kamar rawat inap kelas atas di RS Columbia Asia yang mengusung konsep modern, bersih, dan suportif bagi pemulihan pasien. Ruangan ini dirancang untuk memberikan kenyamanan maksimal layaknya berada di rumah melalui perpaduan interior kayu yang hangat dengan palet warna biru yang menenangkan.\\r\\n",
            "fragment": "rawatinap\\r\\n",
            "link": "rscolumbiaasia/index.html#rawatinap\\r\\n",
            "sceneId": ""
        }
    ],
