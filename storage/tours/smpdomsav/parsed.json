    "objects": [
        {
            "infoId": 337,
            "label": "Ruang Kelas",
            "description": "Ruang kelas di SMP Dominic Savio dilengkapi dengan pendingin udara (AC) untuk menunjang kenyamanan proses belajar mengajar yang kondusif bagi siswa.",
            "fragment": "ruangkelassmpdomsav",
            "link": "smpdomsav/index.html#ruangkelassmpdomsav",
            "sceneId": "node87"
        },
        {
            "infoId": 338,
            "label": "Auditorium",
            "description": "SMP Dominic Savio memiliki sebuah auditorium atau aula yang digunakan sebagai tempat berkumpul dan melaksanakan berbagai kegiatan berskala menengah hingga besar, seperti pertemuan atau pentas seni.",
            "fragment": "auditoriumsmpdomsav",
            "link": "smpdomsav/index.html#auditoriumsmpdomsav",
            "sceneId": "node83"
        },
        {
            "infoId": 339,
            "label": "Lab Komputer",
            "description": "Sekolah ini menyediakan ruangan laboratorium komputer ber-AC, dengan ruangan yang didesain untuk mendukung pembelajaran berbasis teknologi. Keberadaan fasilitas ini sangat penting untuk praktik mata pelajaran TIK dan juga untuk pelaksanaan ujian berbasis komputer.",
            "fragment": "labkomputersmpdomsav",
            "link": "smpdomsav/index.html#labkomputersmpdomsav",
            "sceneId": "node94"
        },
        {
            "infoId": 340,
            "label": "Koperasi",
            "description": "Tersedia satu ruang khusus untuk koperasi sekolah yang berfungsi menyediakan berbagai kebutuhan siswa dan guru, mulai dari alat tulis hingga seragam. Koperasi ini berperan dalam melayani kebutuhan sehari-hari warga sekolah secara praktis dan terorganisir.",
            "fragment": "koperasismpdomsav",
            "link": "smpdomsav/index.html#koperasismpdomsav",
            "sceneId": "node92"
        },
        {
            "infoId": 341,
            "label": "Lapangan",
            "description": "SMP Dominic Savio memiliki lapangan basket berstandar yang menjadi fasilitas utama untuk kegiatan olahraga dan upacara bendera. Lapangan ini juga sering digunakan untuk kegiatan ekstrakurikuler seperti bola voli dan tempat berkumpul untuk kegiatan besar sekolah lainnya.",
            "fragment": "lapangansmpdomsav",
            "link": "smpdomsav/index.html#lapangansmpdomsav",
            "sceneId": "node96"
        }
    ],
