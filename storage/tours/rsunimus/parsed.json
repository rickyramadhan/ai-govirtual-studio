    "objects": [
        {
            "infoId": 1120,
            "label": "Rehabilitasi Medik",
            "description": "Layanan Rehabilitasi Medik di Rumah Sakit Unimus Semarang merupakan fasilitas pemulihan yang komprehensif untuk membantu pasien mengembalikan fungsi tubuh dan kemandirian pasca cedera atau penyakit. Dipimpin oleh dokter spesialis kedokteran fisik dan rehabilitasi (Sp.KFR), layanan ini mencakup berbagai terapi utama seperti fisioterapi, terapi okupasi, dan terapi wicara dengan dukungan peralatan medis modern.",
            "fragment": "rehabilitasi",
            "link": "rsunimus/index.html#rehabilitasi",
            "sceneId": "node26"
        },
        {
            "infoId": 1121,
            "label": "Ruang Operasi",
            "description": "Ruangan ini dirancang khusus untuk melakukan tindakan bedah dalam kondisi yang sangat steril untuk mencegah infeksi. Di bagian tengah, terdapat meja operasi sebagai tempat pasien berbaring, yang dikelilingi oleh lampu operasi besar untuk memberikan pencahayaan maksimal tanpa bayangan bagi tim bedah.",
            "fragment": "ruangoperasi",
            "link": "rsunimus/index.html#ruangoperasi",
            "sceneId": "node22"
        },
        {
            "infoId": 1122,
            "label": "NICU",
            "description": "Ruangan Ini Merupakan Bagian Dari Unit Perawatan Intensif Untuk Bayi Baru Lahir Atau NICU (Neonatal Intensive Care Unit) Di Rumah Sakit Unimus Semarang. Ruangan Ini Dirancang Khusus Dengan Standar Medis Tinggi Untuk Menangani Bayi Yang Memerlukan Pemantauan Ekstra Atau Perawatan Khusus Segera Setelah Lahir.",
            "fragment": "nicu",
            "link": "rsunimus/index.html#nicu",
            "sceneId": "node23"
        },
        {
            "infoId": 1123,
            "label": "PICU",
            "description": "Ruangan ini merupakan Unit Perawatan Intensif Anak (PICU) di Rumah Sakit UNIMUS yang dirancang khusus untuk memberikan perawatan medis tingkat tinggi bagi pasien anak dalam kondisi kritis. Ruangan ini dilengkapi dengan teknologi medis mutakhir, termasuk patient monitor untuk pemantauan tanda vital secara terus-menerus dan sistem syringe pump untuk pemberian obat yang presisi, yang semuanya terintegrasi pada panel dinding (bedhead) standar rumah sakit modern.",
            "fragment": "picu",
            "link": "rsunimus/index.html#picu",
            "sceneId": "node21"
        },
        {
            "infoId": 1187,
            "label": "CT Scan",
            "description": "Mesin ini berfungsi sebagai alat diagnosis tingkat lanjut yang mampu menghasilkan citra tubuh dalam bentuk potongan melintang atau 3D secara presisi dengan cara memutar tabung sinar-X di dalam gantry mengelilingi tubuh pasien.",
            "fragment": "ctscan",
            "link": "rsunimus/index.html#ctscan",
            "sceneId": "node27"
        },
        {
            "infoId": 1188,
            "label": "IGD",
            "description": "IGD RS Unimus merupakan fasilitas medis modern yang dirancang dengan standar tinggi untuk menangani kondisi darurat secara efisien. Secara visual, ruangan ini menonjol karena penerapan sistem triage yang jelas melalui marka warna di lantai, memastikan prioritas penanganan pasien dilakukan secara tepat sasaran.",
            "fragment": "igd",
            "link": "rsunimus/index.html#igd",
            "sceneId": "node19"
        }
    ],
