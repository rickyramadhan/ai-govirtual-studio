    "objects": [
        {
            "infoId": 320,
            "label": "Area Peribadatan",
            "description": "Area ini merupakan ruang utama di dalam gedung gereja Katedral yang berfungsi sebagai pusat perayaan Ekaristi dan liturgi Katolik. Ruangan ini memiliki arsitektur yang megah dengan kapasitas besar, menjadi tempat kedudukan resmi (singgasana) Uskup Agung Semarang.",
            "fragment": "areaperibadatan",
            "link": "gerejakatedral/index.html#areaperibadatan",
            "sceneId": "node15"
        },
        {
            "infoId": 321,
            "label": "Patung Bunda Maria",
            "description": "Patung Bunda Maria (Santa Perawan Maria Ratu Rosario Suci) berada di area Katedral sebagai simbol devosi dan penghormatan kepada ibunda Yesus Kristus. Patung ini menjadi sentral, khususnya saat perayaan Bulan Maria, sering kali diarak dalam prosesi sakral.",
            "fragment": "patungbundamaria",
            "link": "gerejakatedral/index.html#patungbundamaria",
            "sceneId": "node9"
        },
        {
            "infoId": 322,
            "label": "Patung Yesus Kristus",
            "description": "Patung Yesus Kristus merupakan representasi visual yang penting. Patung ini menjadi fokus utama umat saat beribadah, melambangkan pengorbanan dan kehadiran Kristus.",
            "fragment": "patungyesus",
            "link": "gerejakatedral/index.html#patungyesus",
            "sceneId": "node7"
        },
        {
            "infoId": 324,
            "label": "Taman Doa",
            "description": "Taman Doa di kompleks Katedral adalah area luar ruangan yang ditata asri dan damai, dirancang untuk umat melakukan meditasi dan permenungan rohani. Area ini sering digunakan untuk kegiatan doa bersama atau refleksi, seperti saat peringatan hari besar keagamaan.",
            "fragment": "",
            "link": "NULL",
            "sceneId": ""
        }
    ],
