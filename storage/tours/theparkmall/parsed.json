    "objects": [
        {
            "infoId": 139,
            "label": "Ruang Terbuka",
            "description": "Open Space di The Park Mall merujuk pada area indoor dan outdoor di sekitar mall yang sering dimanfaatkan untuk bekerja remote maupun tempat bersantai.",
            "fragment": "openspace",
            "link": "theparkmall/index.html#openspace",
            "sceneId": "node19"
        },
        {
            "infoId": 140,
            "label": "Foodcourt",
            "description": "Foodcourt adalah area kuliner terpusat yang menampung beragam tenant makanan dan minuman. Fasilitas ini menyediakan tempat duduk yang luas dan nyaman bagi pengunjung untuk bersantap.",
            "fragment": "foodcourt",
            "link": "theparkmall/index.html#foodcourt",
            "sceneId": "node20"
        },
        {
            "infoId": 141,
            "label": "Bioskop",
            "description": "Fasilitas Cinema di The Park Mall adalah Cinema XXI, yang menyajikan pengalaman menonton film-film terbaru dengan kualitas studio yang nyaman dan modern. Bioskop ini menjadi salah satu pusat hiburan utama di mall tersebut.",
            "fragment": "cinema",
            "link": "theparkmall/index.html#cinema",
            "sceneId": "node23"
        },
        {
            "infoId": 142,
            "label": "Dunia VR",
            "description": "VR World mengacu pada pusat hiburan modern yang menyediakan permainan dengan teknologi Virtual Reality (VR) atau arcade games lainnya, yang di The Park Mall umumnya diwakili oleh tenant seperti Funworld atau Happy Time. Area ini menawarkan berbagai jenis permainan interaktif untuk menghibur anak-anak dan keluarga.",
            "fragment": "duniavr",
            "link": "theparkmall/index.html#duniavr",
            "sceneId": "node14"
        },
        {
            "infoId": 143,
            "label": "Mushola",
            "description": "Fasilitas Musala tersedia di The Park Mall untuk memudahkan pengunjung melaksanakan ibadah salat dengan tenang dan bersih. Area ibadah ini dilengkapi dengan tempat wudu yang memadai dan berlokasi strategis di dalam mall.",
            "fragment": "mushola",
            "link": "theparkmall/index.html#mushola",
            "sceneId": "node11"
        }
