    "objects": [
        {
            "infoId": 261,
            "label": "Pasar Tani",
            "description": "Saluran pemasaran produk pertanian yang memfasilitasi penjualan komoditas (sayur, buah, olahan) secara langsung dari petani atau kelompok tani kepada konsumen. Tujuannya adalah memotong rantai distribusi yang panjang, sehingga petani mendapatkan harga jual yang lebih adil dan konsumen memperoleh produk segar dengan harga yang kompetitif.",
            "fragment": "pasartani",
            "link": "agrocepoko/index.html#pasartani",
            "sceneId": "node11"
        },
        {
            "infoId": 262,
            "label": "Greenhouse Melon",
            "description": "Greenhouse Hidroponik Melon adalah ruang metode budidaya melon premium di dalam bangunan tertutup transparan yang berfungsi mengontrol suhu dan kelembaban lingkungan tanam. Sistem ini memungkinkan tanaman melon tumbuh optimal tanpa menggunakan tanah, melainkan mendapatkan nutrisi lengkap langsung dari larutan air untuk menghasilkan buah berkualitas tinggi.",
            "fragment": "greenhousemelon",
            "link": "agrocepoko/index.html#greenhousemelon",
            "sceneId": "node6"
        },
        {
            "infoId": 263,
            "label": "Pembibitan",
            "description": "Tempat khusus yang dikelola dan dirancang untuk memproses benih menjadi bibit (tanaman muda) yang siap tanam di lapangan. Area ini menyediakan lingkungan yang terkontrol, seperti naungan, media tanam, dan air yang memadai, demi memastikan bibit tumbuh kuat, sehat, dan seragam sebelum dipindahkan.",
            "fragment": "pembibitan",
            "link": "agrocepoko/index.html#pembibitan",
            "sceneId": "node12"
        },
        {
            "infoId": 264,
            "label": "Aula Pertemuan",
            "description": "Bangunan serbaguna tertutup yang berlokasi di lingkungan kebun, dirancang sebagai tempat utama untuk menyelenggarakan pelatihan, seminar, dan workshop skala besar. Fungsi utamanya adalah memberikan fasilitas yang nyaman dan profesional untuk transfer ilmu pengetahuan pertanian, pembekalan teknis, dan kegiatan komunitas yang mendukung edukasi.",
            "fragment": "aulapertemuan",
            "link": "agrocepoko/index.html#aulapertemuan",
            "sceneId": "node2"
        },
        {
            "infoId": 265,
            "label": "Playground",
            "description": "Area bermain yang dirancang secara khusus di tengah lingkungan kebun, dilengkapi dengan peralatan aman yang mendukung perkembangan motorik dan sosial anak. Fungsi utamanya adalah memberikan sarana rekreasi yang menyenangkan sekaligus interaktif, memungkinkan anak-anak belajar mengenai alam dan pertanian sambil aktif bergerak di udara terbuka.",
            "fragment": "playground",
            "link": "agrocepoko/index.html#playground",
            "sceneId": "node16"
        }
    ],
