    "objects": [
        {
            "infoId": 155,
            "label": "Aula",
            "description": "Aula Gedung E adalah ruang serbaguna utama di kampus yang mampu menampung hingga 450 peserta. Fasilitas ini dilengkapi dengan pendingin ruangan dan proyektor LCD, cocok untuk seminar, workshop, dan kuliah umum.",
            "fragment": "aula",
            "link": "udinus/index.html#aula",
            "sceneId": "node82"
        },
        {
            "infoId": 156,
            "label": "Bengkel Koding",
            "description": "Bengkel Koding di UDINUS Semarang adalah komunitas dan pusat pembelajaran praktis di bawah Program Studi Teknik Informatika, bertujuan meningkatkan kemampuan pemrograman mahasiswa. Fasilitas ini menyediakan kursus online dan offline, proyek coding nyata, serta dukungan mentor satu-satu untuk mendorong solusi dan inovasi digital.",
            "fragment": "bengkelkoding",
            "link": "udinus/index.html#bengkelkoding",
            "sceneId": "node83"
        },
        {
            "infoId": 157,
            "label": "Lab Anatomi",
            "description": "Laboratorium Anatomi di Fakultas Kedokteran UDINUS Semarang adalah fasilitas pembelajaran struktur tubuh manusia, dilengkapi spesimen, alat peraga anatomi kering, serta Anatomage Table untuk simulasi bedah virtual. Laboratorium ini juga menyediakan ruang praktik menggunakan kadaver (anatomi basah) sebagai media utama pembelajaran bagi mahasiswa kedokteran.",
            "fragment": "labanatomi",
            "link": "udinus/index.html#labanatomi",
            "sceneId": "node87"
        },
        {
            "infoId": 158,
            "label": "Studio TV",
            "description": "Studio TV di UDINUS Semarang beroperasi sebagai TVKU (Televisi Kampus Universitas Dian Nuswantoro), stasiun televisi lokal sekaligus media praktik utama bagi mahasiswa. Studio ini dilengkapi peralatan siaran profesional untuk produksi konten edukasi, berita, dan talkshow yang dapat disaksikan publik di Jawa Tengah.",
            "fragment": "studiotv",
            "link": "udinus/index.html#studiotv",
            "sceneId": "node114"
        },
        {
            "infoId": 159,
            "label": "Lab Animasi",
            "description": "Laboratorium Animasi di UDINUS Semarang adalah pusat praktik utama bagi mahasiswa Program Studi Animasi, dilengkapi Laboratorium Gambar, Laboratorium Fotografi, dan peralatan animasi canggih termasuk stop motion dan perangkat lunak industri.",
            "fragment": "labanimasi",
            "link": "udinus/index.html#labanimasi",
            "sceneId": "node102"
        },
        {
            "infoId": 160,
            "label": "Lab Biomokuler",
            "description": "Fasilitas Laboratorium Biomolekuler di Fakultas Kedokteran UDINUS Semarang adalah laboratorium yang berfokus pada kajian molekul dan interaksi biologis yang mendalam di dalam sel dan organisme. Lab ini merupakan bagian dari 10 Laboratorium Biomedik yang digunakan mahasiswa untuk praktikum serta penelitian terkait biomolekul, seperti protein, karbohidrat, dan proses metabolisme.",
            "fragment": "labbiomokuler",
            "link": "udinus/index.html#labbiomokuler",
            "sceneId": "node103"
        },
        {
            "infoId": 161,
            "label": "Lab Stop Motion",
            "description": "Fasilitas Lab Stop Motion di UDINUS Semarang adalah bagian dari Laboratorium Animasi yang secara spesifik digunakan untuk mengembangkan dan memproduksi animasi berjenis stop motion. Laboratorium ini menyediakan perangkat dan ruang yang mendukung, termasuk media diorama pedesaan untuk praktik mahasiswa dalam menghasilkan karya animasi bergerak bingkai per bingkai.",
            "fragment": "labstopmotion",
            "link": "udinus/index.html#labstopmotion",
            "sceneId": "node107"
        },
        {
            "infoId": 162,
            "label": "Rooftop",
            "description": "Rooftop Garden (Taman Atap) merupakan area hijau di salah satu gedung, seperti Gedung H, yang berfungsi sebagai tempat relaksasi dan ruang publik. Fasilitas ini sering dimanfaatkan sebagai kelas outdoor kreatif untuk mahasiswa agar terhindar dari kebosanan perkuliahan di dalam ruangan.",
            "fragment": "rooftop",
            "link": "udinus/index.html#rooftop",
            "sceneId": "node113"
        }
