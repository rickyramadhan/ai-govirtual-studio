    "objects": [
        {
            "infoId": 502,
            "label": "Ruang Pelayanan SKCK",
            "description": "Ruang pelayanan SKCK adalah loket khusus di lingkungan kepolisian yang dirancang sebagai pusat kontak langsung bagi masyarakat. Fungsinya adalah memproses dan menerbitkan Surat Keterangan Catatan Kepolisian (SKCK) untuk berbagai keperluan administrasi.",
            "fragment": "ruangskck",
            "link": "polda/index.html#ruangskck",
            "sceneId": "node14"
        },
        {
            "infoId": 503,
            "label": "Ruang SPKT",
            "description": "Ruang SPKT (Sentra Pelayanan Kepolisian Terpadu) adalah unit layanan garis depan di kantor polisi yang bertugas menerima semua laporan dan pengaduan dari masyarakat selama 24 jam. Fungsi utamanya adalah memberikan pelayanan kepolisian terpadu, mulai dari Laporan Polisi (LP), laporan kehilangan, hingga permintaan bantuan dan pertolongan pertama.",
            "fragment": "ruangspkt",
            "link": "polda/index.html#ruangspkt",
            "sceneId": "node3"
        },
        {
            "infoId": 504,
            "label": "Ruang 110",
            "description": "Pusat layanan darurat (Call Center) Kepolisian Negara Republik Indonesia yang beroperasi 24 jam sehari dengan nomor telepon bebas pulsa 110. Fungsi utamanya adalah menerima laporan cepat dari masyarakat mengenai situasi darurat, tindak kejahatan, atau gangguan ketertiban, untuk ditindaklanjuti segera oleh petugas di lapangan.",
            "fragment": "ruang110",
            "link": "polda/index.html#ruang110",
            "sceneId": "node1"
        },
        {
            "infoId": 505,
            "label": "Lobby Utama",
            "description": "Ruangan penerima tamu, pengunjung, atau masyarakat yang datang. Fungsinya adalah menyaring, mengarahkan, dan memberikan informasi awal kepada publik, sekaligus mencerminkan citra profesionalitas institusi kepolisian daerah tersebut.",
            "fragment": "lobbyutama",
            "link": "polda/index.html#lobbyutama",
            "sceneId": "node9"
        }
    ],
