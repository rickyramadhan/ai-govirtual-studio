    "objects": [
        {
            "infoId": 236,
            "label": "Patung Legenda Goa Kreo",
            "description": "Patung ini merepresentasikan kera yang dipercaya membantu Sunan Kalijaga dalam mencari dan mengamankan kayu jati untuk Masjid Demak. Patung-patung ini menjadi penanda visual dari legenda \"Mangreho\" (jagalah) yang diucapkan Sunan Kalijaga kepada kawanan kera tersebut, yang kemudian menjadi asal nama Goa Kreo.",
            "fragment": "patunggoakreo",
            "link": "goakreo/index.html#patunggoakreo",
            "sceneId": "node10"
        },
        {
            "infoId": 237,
            "label": "Jembatan Goa Kreo",
            "description": "Jembatan ini adalah jembatan gantung panjang yang menjadi akses utama bagi pengunjung untuk menyeberang dan mencapai lokasi Goa Kreo yang kini berada di tengah Waduk Jatibarang. Dari atas jembatan, pengunjung dapat menikmati pemandangan Waduk Jatibarang dan perbukitan hijau, menjadikannya salah satu spot foto paling ikonik di kawasan tersebut.",
            "fragment": "jembatangoakreo",
            "link": "goakreo/index.html#jembatangoakreo",
            "sceneId": "node5"
        },
        {
            "infoId": 238,
            "label": "Goa Kreo",
            "description": "Goa Kreo merupakan gua alami yang diyakini sebagai petilasan Sunan Kalijaga saat beliau bertapa dan bertemu dengan empat ekor kera. Saat ini, goa ini dan kawasan sekitarnya dihuni oleh ratusan kera ekor panjang yang dianggap sebagai \"penjaga\" warisan spiritual dan alam di lokasi tersebut.",
            "fragment": "goakreo",
            "link": "goakreo/index.html#goakreo",
            "sceneId": "node2"
        }
    ],
