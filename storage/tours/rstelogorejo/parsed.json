    "objects": [
        {
            "infoId": 1140,
            "label": "Hub Layanan Terpadu",
            "description": "Area ini merupakan jantung operasional non-medis di RS Telogorejo yang didesain dengan konsep patient-centric. Tujuannya adalah untuk meminimalkan kebingungan pasien saat baru tiba dan memastikan transisi dari kedatangan menuju tindakan medis berjalan lancar. Penggunaan teknologi (layar digital) dan kenyamanan fisik (berbagai tipe kursi) menunjukkan komitmen rumah sakit dalam memberikan pengalaman layanan kesehatan yang profesional dan modern.",
            "fragment": "layananterpadu",
            "link": "rstelogorejo/index.html#layananterpadu",
            "sceneId": "node7"
        },
        {
            "infoId": 1141,
            "label": "Klinik Anak",
            "description": "SMC Health Kids (Poliklinik Anak RS Telogorejo) adalah fasilitas kesehatan yang dirancang secara holistik untuk mengubah stigma rumah sakit yang menakutkan bagi anak-anak menjadi tempat yang menyenangkan dan edukatif. Menyediakan solusi kesehatan satu pintu, mulai dari pemeriksaan dokter spesialis dan sub-spesialis, imunisasi, hingga pemantauan tumbuh kembang yang mendalam.",
            "fragment": "klinikanak",
            "link": "rstelogorejo/index.html#klinikanak",
            "sceneId": "node8"
        },
        {
            "infoId": 1142,
            "label": "Management Office",
            "description": "Sebagai pusat manajemen dan administrasi, area ini dirancang untuk menjadi titik kendali yang efektif, memastikan alur informasi dan birokrasi antara pasien dan pihak rumah sakit berjalan transparan, cepat, dan profesional.",
            "fragment": "management",
            "link": "rstelogorejo/index.html#management",
            "sceneId": "node6"
        },
        {
            "infoId": 1143,
            "label": "Klinik Obsgyn",
            "description": "Obsgyn Clinic (Klinik Kebidanan dan Kandungan) di RS Telogorejo Semarang dapat disimpulkan sebagai pusat layanan kesehatan reproduksi yang menggabungkan pendekatan medis canggih dengan kenyamanan eksklusif. RS Telogorejo merupakan salah satu pelopor penerapan metode ERACS (Enhanced Recovery After Cesarean Section) di Semarang. Metode ini memungkinkan ibu pasca-operasi caesar untuk pulih jauh lebih cepat (bisa duduk dan berjalan dalam waktu singkat) dibandingkan metode konvensional.",
            "fragment": "klinikobsgyn",
            "link": "rstelogorejo/index.html#klinikobsgyn",
            "sceneId": "node12"
        },
        {
            "infoId": 1144,
            "label": "IGD",
            "description": "IGD RS Telogorejo tampak siap melayani berbagai kasus kegawatdaruratan selama 24 jam dengan dukungan teknologi medis yang komprehensif dan lingkungan yang terorganisir dengan baik. Fasilitas ini dirancang untuk memberikan rasa aman bagi pasien melalui perpaduan antara tenaga medis yang siaga dan infrastruktur medis yang lengkap.",
            "fragment": "igd",
            "link": "rstelogorejo/index.html#igd",
            "sceneId": "node17"
        }
    ],
