    "objects": [
        {
            "infoId": 1061,
            "label": "Ruang Meeting Besar",
            "description": "Restoran Pesta Keboen memiliki ruangan besar yang berdesain kolonial dan kerap digunakan untuk acara pertemuan, seperti meeting atau acara keluarga, dengan suasana yang homey dan bernuansa tempo dulu. Ruangan ini terletak di sisi kanan pintu masuk utama dan mampu menampung tamu dalam jumlah sedang hingga banyak dengan dekorasi dinding yang khas.",
            "fragment": "meetingbesar",
            "link": "pestakeboen/index.html#meetingbesar",
            "sceneId": "node14"
        },
        {
            "infoId": 1062,
            "label": "Meeting Room Kecil",
            "description": "Resto Pesta Keboen menyediakan ruangan-ruangan kecil yang bersifat privat (di samping ruangan besar) yang cocok digunakan untuk pertemuan kecil atau acara keluarga dengan jumlah peserta terbatas. Ruangan kecil ini dirancang dengan dekorasi klasik kolonial dan suasana yang nyaman, memberikan nuansa intim untuk diskusi atau perayaan santai.",
            "fragment": "meetingkecil",
            "link": "pestakeboen/index.html#meetingkecil",
            "sceneId": "node15"
        },
        {
            "infoId": 1063,
            "label": "Teras (Tempat makan outdoor)",
            "description": "Teras atau area makan outdoor di Pesta Keboen didominasi oleh suasana ala taman yang asri, dikelilingi oleh tanaman hias seperti pohon pisang kipas, yang menawarkan nuansa bersantap di alam terbuka. Area ini juga dilengkapi dengan beberapa gazebo kayu kecil dan sering menjadi tempat pertunjukan live music untuk menambah nuansa romantis dan ceria.",
            "fragment": "teras",
            "link": "pestakeboen/index.html#teras",
            "sceneId": "node22"
        },
        {
            "infoId": 1064,
            "label": "Tempat Makan Indoor",
            "description": "Area makan indoor Resto Pesta Keboen berada di dalam rumah kuno bergaya kolonial Belanda tahun 1908, yang dipertahankan dengan kuatnya nuansa tempo dulu. Interiornya dihiasi oleh ornamen klasik, foto-foto jadul, dan elemen kayu, menciptakan suasana yang hangat, homey, dan mewah khas rumah kuno.",
            "fragment": "makanindoor",
            "link": "pestakeboen/index.html#makanindoor",
            "sceneId": "node16"
        }
    ],
