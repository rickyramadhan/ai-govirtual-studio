    "objects": [
        {
            "infoId": 1163,
            "label": "Waiting Room",
            "description": "Waiting Room Area tunggu atau lobi di hotel ini dirancang dengan gaya industrial yang sangat trendi dan nyaman bagi para tamu yang baru tiba. Ruang ini dilengkapi dengan berbagai spot foto menarik dan fasilitas hiburan yang mencerminkan konsep smart-urban hotel.",
            "fragment": "waitingroom",
            "link": "hotelroomsinc/index.html#waitingroom",
            "sceneId": "node9"
        },
        {
            "infoId": 1164,
            "label": "Moonlounge",
            "description": "Moonlounge merupakan area ikonik untuk bersantai, tempat ini sering digunakan sebagai titik kumpul yang estetik bagi para tamu untuk menikmati musik, makanan, dan suasana yang modern.",
            "fragment": "moonlounge",
            "link": "hotelroomsinc/index.html#moonlounge",
            "sceneId": "node17"
        },
        {
            "infoId": 1165,
            "label": "Gym",
            "description": "Fasilitas pusat kebugaran ini menyediakan berbagai alat olahraga esensial untuk menjaga stamina tamu selama menginap. Ruangannya didesain minimalis namun fungsional agar aktivitas olahraga tetap terasa menyenangkan dan privat.",
            "fragment": "gym",
            "link": "hotelroomsinc/index.html#gym",
            "sceneId": "node2"
        },
        {
            "infoId": 1166,
            "label": "Meeting Room",
            "description": "Rooms Inc menyediakan ruang pertemuan serbaguna dengan fasilitas audiovisual lengkap untuk menunjang kebutuhan bisnis atau acara formal. Ruang ini memiliki desain yang energik dan fleksibel sehingga dapat disesuaikan dengan berbagai skala kegiatan.",
            "fragment": "meetingroom",
            "link": "hotelroomsinc/index.html#meetingroom",
            "sceneId": "node6"
        },
        {
            "infoId": 1167,
            "label": "Superior Queen Room",
            "description": "Tipe kamar ini menawarkan kenyamanan tidur berkualitas dengan kasur berukuran queen dan desain interior yang modern. Kamar ini dilengkapi dengan fasilitas pintar dan pencahayaan yang hangat untuk menjamin pengalaman beristirahat yang maksimal.",
            "fragment": "superiorqueenroom",
            "link": "hotelroomsinc/index.html#superiorqueenroom",
            "sceneId": "node10"
