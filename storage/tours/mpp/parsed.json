    "objects": [
        {
            "infoId": 511,
            "label": "Anoman",
            "description": "Ruang Anoman adalah ruang yang disediakan untuk pengunjung Mall Pelayanan Publik yang ada di Terminal Mangkang. Ruang ini dimaksudkan sebagai fasilitas self service bagi pengunjung yang ingin mengurus perizinan yang berkaitan dengan DPMPTSP maupun beberapa layanan di MPP.",
            "fragment": "anoman",
            "link": "mpp/index.html#anoman",
            "sceneId": "node161"
        },
        {
            "infoId": 512,
            "label": "Caffe Investasi",
            "description": "Cafe investasi adalah fasilitas yang ada di Mal Pelayanan Publik yang berada di Terminal Mangkang. Cafe investasi ini menyediakan ruang pertemuan untuk tempat konsultasi maupun pertemuan bagi para investor dan pelaku usaha.",
            "fragment": "cafeinvestasi",
            "link": "mpp/index.html#cafeinvestasi",
            "sceneId": "node162"
        },
        {
            "infoId": 513,
            "label": "MPP",
            "description": "MPP Terminal Mangkang adalah pusat layanan terpadu yang menyajikan lebih dari 200 jenis layanan publik, termasuk perizinan usaha, layanan SIM, SKCK, Dukcapil, dan perpajakan, yang disediakan oleh puluhan instansi dalam satu gedung. Untuk kenyamanan, fasilitas pendukungnya mencakup konter layanan, ruang laktasi, playground anak, meeting room, lift/fasilitas difabel, hingga mushola dan ATM center.",
            "fragment": "mpp",
            "link": "mpp/index.html#mpp",
            "sceneId": "node177"
        }
    ],
