    "objects": [
        {
            "infoId": 690,
            "label": "Sign Pantai Tirang",
            "description": "Sign atau ikon di Pantai Tirang lebih bersifat rustic (sederhana/alami) dan dikelola secara swadaya oleh warga sekitar (Kelompok Sadar Wisata). Sign ini menjadi lokasi foto favorit bagi pengunjung karna menawarkan pemandangan yang langsung mengarah ke laut.",
            "fragment": "signpantaitirang",
            "link": "pantaitirang/index.html#signpantaitirang",
            "sceneId": "node12"
        },
        {
            "infoId": 691,
            "label": "Jembatan",
            "description": "Selain untuk berwisata, ujung jembatan ini sering dimanfaatkan oleh warga lokal atau pemancing hobi (angler) untuk melemparkan kail ke area yang lebih dalam tanpa harus berenang ke tengah. Anda mungkin akan sering melihat orang duduk memancing di ujung jembatan ini pada pagi atau sore hari.",
            "fragment": "jembatan",
            "link": "pantaitirang/index.html#jembatan",
            "sceneId": "node2"
        },
        {
            "infoId": 692,
            "label": "Pantai",
            "description": "Pantai ini terletak tepat di sebelah landasan pacu Bandara Internasional Jenderal Ahmad Yani. Ini menjadikan Pantai Tirang satu-satunya tempat di Semarang di mana Anda bisa menikmati suasana pantai sambil melihat pesawat take-off dan landing dari jarak dekat.",
            "fragment": "pantai",
            "link": "pantaitirang/index.html#pantai",
            "sceneId": "node13"
        },
        {
            "infoId": 693,
            "label": "Gazebo",
            "description": "Keberadaan gazebo-gazebo ini menjadikan Pantai Tirang destinasi yang \"ramah keluarga\" karena orang tua bisa bersantai dengan nyaman sementara anak-anak bermain di pantai. Pengunjung biasanya memesan makanan (seperti mendoan hangat, mie rebus, atau kelapa muda) dari warung sekitar dan menikmatinya di gazebo ini bersama keluarga.",
            "fragment": "gazebo",
            "link": "pantaitirang/index.html#gazebo",
            "sceneId": "node9"
        },
        {
            "infoId": 694,
            "label": "UMKM",
            "description": "Warung-warung semi-permanen yang berjejer rapi menghadap pantai. Beberapa warung menyediakan tempat duduk lesehan. Menu andalan di sini sangat sederhana namun nikmat disantap di pinggir pantai. Yang paling populer adalah Kelapa Muda, Mendoan/Gorengan panas, Mie Instan (rebus/goreng), dan ikan bakar sederhana.",
            "fragment": "umkm",
            "link": "pantaitirang/index.html#umkm",
            "sceneId": "node14"
        }
    ],
