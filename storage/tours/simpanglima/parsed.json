    "objects": [
        {
            "infoId": 910,
            "label": "Lapangan Voli",
            "description": "Lapangan voli di Simpang Lima Semarang merupakan fasilitas olahraga publik strategis yang terletak tepat di jantung kota sebagai pusat aktivitas fisik masyarakat. Area ini menjadi ruang terbuka favorit warga untuk berlatih maupun bertanding voli sambil menikmati suasana keramaian ikonik Jawa Tengah.",
            "fragment": "lapanganvoli",
            "link": "simpanglima/index.html#lapanganvoli",
            "sceneId": "node91"
        },
        {
            "infoId": 911,
            "label": "Lapangan Pancasila",
            "description": "Lapangan Pancasila di Simpang Lima merupakan ruang terbuka hijau ikonik yang berfungsi sebagai pusat kegiatan masyarakat sekaligus paru-paru Kota Semarang. Area luas ini menjadi titik temu strategis untuk berbagai aktivitas, mulai dari upacara resmi, olahraga pagi, hingga pusat wisata kuliner di malam hari.",
            "fragment": "lapanganpancasila",
            "link": "simpanglima/index.html#lapanganpancasila",
            "sceneId": "node90"
        },
        {
            "infoId": 912,
            "label": "Taman Hati",
            "description": "Spot swafoto berbentuk hati yang terletak di Lapangan Pancasila, jantung pusat Kota Semarang. Ikon estetis ini menjadi daya tarik utama bagi pengunjung untuk mengabadikan momen dengan latar belakang lampu kota yang romantis saat malam hari.",
            "fragment": "tamanhati",
            "link": "simpanglima/index.html#tamanhati",
            "sceneId": "node79"
        },
        {
            "infoId": 913,
            "label": "Landmark Simpang Lima",
            "description": "Landmark Simpang Lima Semarang merupakan lokasi bertuliskan \"Lapangan Pancasila Simpang Lima\" merupakan ikon kebanggaan kota yang menandai titik pertemuan lima jalan utama di Jawa Tengah. Kehadiran struktur visual yang modern dan estetik ini mempertegas identitas kawasan sebagai pusat aktivitas publik sekaligus menjadi spot foto favorit bagi wisatawan yang berkunjung ke jantung Kota Semarang.",
            "fragment": "landmarksimpanglima",
            "link": "simpanglima/index.html#landmarksimpanglima",
            "sceneId": "node88"
        }
