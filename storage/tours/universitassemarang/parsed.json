    "objects": [
        {
            "infoId": 388,
            "label": "Museum",
            "description": "Museum pusat dokumentasi yang merekam perjalanan perkembangan kampus sejak awal pendiriannya. Koleksinya mencakup benda-benda bersejarah, dokumentasi, dan foto-foto yang menggambarkan transformasi USM, menjadikannya sarana edukasi tentang sejarah perguruan tinggi tersebut.",
            "fragment": "museum",
            "link": "universitassemarang/index.html#museum",
            "sceneId": "node16"
        },
        {
            "infoId": 389,
            "label": "Radio",
            "description": "Universitas Semarang (USM) memiliki stasiun radio kampus resmi bernama USM Jaya 101.6 FM yang menyiarkan berbagai program edukasi, berita, dan hiburan untuk komunitas kampus dan masyarakat Semarang. Radio ini juga menjadi sarana praktik utama bagi mahasiswa yang tergabung dalam Unit Kegiatan Mahasiswa (UKM) broadcasting, yaitu UKM PROMISE (Podcast dan Radio Mahasiswa Universitas Semarang).",
            "fragment": "radio",
            "link": "universitassemarang/index.html#radio",
            "sceneId": "node27"
        },
        {
            "infoId": 390,
            "label": "USM TV",
            "description": "Televisi komunitas berbasis kampus resmi milik Universitas Semarang yang menyiarkan program-program kreatif, mendidik, dan berbudaya sesuai Tri Dharma Perguruan Tinggi. Mengudara di kanal digital (seperti 30 UHF di wilayah Jateng 1) dan juga aktif melalui platform digital seperti YouTube, USM TV berfungsi sebagai media informasi dan praktik bagi mahasiswa broadcasting.",
            "fragment": "",
            "link": "universitassemarang/index.html#",
            "sceneId": ""
        },
        {
            "infoId": 391,
            "label": "Ruang Kelas",
            "description": "Sarana akademik yang dirancang memadai dengan fasilitas modern, umumnya dilengkapi dengan AC, LCD Proyektor, dan White Board. Tujuan dari penyediaan fasilitas ini adalah untuk menciptakan lingkungan belajar yang nyaman dan kondusif, mendukung proses perkuliahan, diskusi, dan kegiatan akademik lainnya.",
            "fragment": "ruangkelas",
            "link": "universitassemarang/index.html#ruangkelas",
            "sceneId": "node26"
        },
        {
            "infoId": 392,
            "label": "BBJ",
            "description": "BBJ (Bina Bahasa Jaya) adalah pusat atau lembaga di Universitas Semarang yang fokus pada layanan bahasa, utamanya menyelenggarakan tes kecakapan bahasa seperti TOEFL untuk mahasiswa USM maupun umum. Lembaga ini berfungsi sebagai fasilitas akademik untuk meningkatkan kompetensi bahasa dan menyediakan sertifikasi yang dibutuhkan untuk kelulusan dan keperluan studi lanjut.",
            "fragment": "bbj",
            "link": "universitassemarang/index.html#bbj",
            "sceneId": "node7"
        },
        {
            "infoId": 393,
            "label": "Telekonferensi",
            "description": "Universitas Semarang (USM) menyediakan fasilitas khusus berupa Ruang Telekonferensi, umumnya terletak di Gedung Menara USM, untuk mendukung komunikasi jarak jauh. Fasilitas ini secara rutin digunakan untuk kegiatan akademik dan manajerial, seperti pelaksanaan konferensi internasional, rapat tinjauan mutu, dan Focus Group Discussion (FGD) dengan pihak luar kampus.",
            "fragment": "telekonferensi",
            "link": "universitassemarang/index.html#telekonferensi",
            "sceneId": "node32"
        },
        {
            "infoId": 394,
            "label": "Ruang Sidang",
            "description": "Universitas Semarang menyediakan Ruang Sidang yang representatif dan berfasilitas lengkap untuk menunjang berbagai kegiatan penting seperti rapat pimpinan, sidang skripsi, dan diskusi resmi. Ruangan ini umumnya dilengkapi dengan pendingin udara (AC), LCD Proyektor, dan tata suara yang memadai untuk memastikan kelancaran acara dan suasana formal.",
            "fragment": "",
            "link": "NULL",
            "sceneId": ""
        }
