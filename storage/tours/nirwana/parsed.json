    "objects": [
        {
            "infoId": 682,
            "label": "Aviary dan Playground",
            "description": "Aviary adalah kandang burung besar yang menampung koleksi unggas, termasuk burung-burung eksotis, untuk dilihat dan terkadang diberi makan oleh pengunjung. Area ini seringkali terintegrasi dengan playground (tempat bermain) yang dilengkapi wahana sederhana seperti ayunan dan perosotan untuk anak-anak.",
            "fragment": "aviarydanplayground",
            "link": "nirwana/index.html#aviarydanplayground",
            "sceneId": "node122"
        },
        {
            "infoId": 683,
            "label": "Kandang Kuda",
            "description": "Stable adalah kandang utama tempat koleksi kuda, termasuk kuda poni, dirawat dan dipersiapkan untuk kegiatan berkuda. Di sini pengunjung dapat mengenal berbagai jenis kuda dan melihat langsung proses perawatan kuda-kuda yang terawat.",
            "fragment": "kandangkuda",
            "link": "nirwana/index.html#kandangkuda",
            "sceneId": "node108"
        },
        {
            "infoId": 684,
            "label": "Rumah Kaca",
            "description": "Greenhouse (rumah kaca) adalah area yang digunakan untuk membudidayakan tanaman, termasuk sistem hidroponik, meskipun aksesnya mungkin terbatas atau tidak selalu dijaga petugas. Area ini menambah unsur edukasi pertanian dan keasrian lingkungan di sekitar restoran.",
            "fragment": "rumahkaca",
            "link": "nirwana/index.html#rumahkaca",
            "sceneId": "node107"
        },
        {
            "infoId": 685,
            "label": "Nirwana Resto",
            "description": "Nirwana Resto adalah restoran utama di lokasi tersebut yang menyajikan beragam pilihan menu, mulai dari hidangan khas Nusantara hingga menu Western. Restoran ini menawarkan pengalaman bersantap yang nyaman dengan pemandangan alam sekitar yang hijau dan menenangkan.",
            "fragment": "nirwanaresto",
            "link": "nirwana/index.html#nirwanaresto",
            "sceneId": "node111"
        },
        {
            "infoId": 686,
            "label": "Kafe",
            "description": "Caffe adalah area santai yang khusus menyajikan minuman, terutama kopi khas, serta makanan ringan atau snack. Tempat ini ideal untuk nongkrong, Work From Cafe (WFC), atau sekadar menikmati live music di akhir pekan.",
            "fragment": "kafe",
            "link": "nirwana/index.html#kafe",
            "sceneId": "node120"
        },
        {
            "infoId": 687,
            "label": "Arena Latihan Berkuda",
            "description": "Arena Latihan Berkuda adalah fasilitas utama untuk kegiatan rekreasi dan edukasi berkuda bagi pengunjung dari berbagai kalangan. Tempat ini menawarkan paket belajar berkuda, di mana pengunjung akan didampingi pelatih berpengalaman dengan perlengkapan lengkap.",
            "fragment": "arenalatihankuda",
            "link": "nirwana/index.html#arenalatihankuda",
            "sceneId": "node115"
        },
        {
            "infoId": 688,
            "label": "Reulian Garden",
            "description": "Area outdoor yang disediakan oleh pengelola untuk bisa digunakan guna berbagai aktivitas, seperti pernikahan, maupun acara besar lainnya.",
            "fragment": "reuliangarden",
            "link": "nirwana/index.html#reuliangarden",
            "sceneId": "node113"
        }
    ],
