    "objects": [
        {
            "infoId": 2235,
            "label": "Konter",
            "description": "Melalui penggunaan menu digital yang informatif, pelanggan diberikan kemudahan untuk memilih berbagai varian lumpia, mulai dari rasa original hingga inovasi seafood dan western, lengkap dengan pilihan teknik memasak (basah, goreng, atau teppan). Area transaksi yang rapi, dukungan pembayaran non-tunai via QRIS, serta tampilan stok kemasan kotak merah yang ikonik menunjukkan kesiapan toko dalam menangani pesanan oleh-oleh dalam skala besar.",
            "fragment": "counter",
            "link": "loenpiambaklien/index.html#counter",
            "sceneId": "node46"
        },
        {
            "infoId": 2236,
            "label": "Ruang Makan",
            "description": "Penempatan meja makan yang bersandingan langsung dengan rak oleh-oleh memberikan pengalaman yang unik dan efisien, sementara sentuhan dekorasi seperti foto dokumentasi lama dan tanaman gantung menambah kesan hangat serta homey. Secara keseluruhan, area ini bukan sekadar tempat untuk menyantap kuliner, melainkan sebuah ruang yang merepresentasikan pelestarian warisan budaya yang tetap relevan dan nyaman bagi wisatawan masa kini.",
            "fragment": "diningarea",
            "link": "loenpiambaklien/index.html#diningarea",
            "sceneId": "node43"
        },
        {
            "infoId": 2237,
            "label": "Etalase Produk Oleh-Oleh",
            "description": "Etalase produk oleh-oleh di Toko Loenpia Mbak Lien menyajikan ragam camilan kering tradisional dan modern yang dikemas secara praktis untuk dibawa bepergian. Secara keseluruhan, bagian etalase ini berfungsi sebagai pelengkap strategis bagi menu utama lumpia, memberikan pilihan buah tangan yang tahan lama dan mudah didistribusikan sebagai oleh-oleh khas Semarang.",
            "fragment": "etalase",
            "link": "loenpiambaklien/index.html#etalase",
            "sceneId": "node49"
        }
    ],
