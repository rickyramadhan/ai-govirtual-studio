# Deny access to sensitive files
<FilesMatch "\.(env|log|cache)$">
    Require all denied
</FilesMatch>

# Deny access to cache directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^cache/ - [F,L]
</IfModule>

# Allow CORS for API
<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
