    "objects": [
        {
            "infoId": 215,
            "label": "Kantin",
            "description": "Area kantin di TBRS berfungsi sebagai fasilitas penunjang untuk memenuhi kebutuhan kuliner bagi pengunjung, seniman, maupun staf yang beraktivitas. Tempat ini menyediakan ruang istirahat yang nyaman bagi mereka yang ingin bersantap atau sekadar menikmati minuman di tengah kegiatan budaya.",
            "fragment": "kantin",
            "link": "tamanbudaya/index.html#kantin",
            "sceneId": "node11"
        },
        {
            "infoId": 216,
            "label": "Ruang Meeting Gedung Ki Narto Sabdo",
            "description": "Ruang Meeting Gedung Ki Narto Sabdo memiliki ruang pendukung yang dapat difungsikan sebagai ruang pertemuan skala kecil atau ruang diskusi. Ruangan-ruangan ini melayani kebutuhan komunitas seni untuk rapat atau persiapan sebelum pementasan di gedung utama.",
            "fragment": "meetingnartosabdo",
            "link": "tamanbudaya/index.html#meetingnartosabdo",
            "sceneId": "node20"
        },
        {
            "infoId": 217,
            "label": "Ruang Administrasi",
            "description": "Ruang administrasi berada di Kantor Pengelola TBRS yang merupakan pusat manajemen dan operasional seluruh kompleks taman budaya. Di sinilah segala urusan tata kelola, perizinan penggunaan fasilitas, dan koordinasi program kesenian dilaksanakan.",
            "fragment": "administrasi",
            "link": "tamanbudaya/index.html#administrasi",
            "sceneId": "node19"
        },
        {
            "infoId": 218,
            "label": "Gedung Kesenian Ki Narto Sabdho",
            "description": "Gedung ini merupakan gedung pertunjukan utama di TBRS, dinamai untuk menghormati maestro wayang terkenal. Gedung ini dilengkapi fasilitas modern (seperti tata suara dan pencahayaan) dan rutin digunakan untuk pementasan wayang orang Ngesti Pandawa, wayang kulit, teater, dan musik keroncong.",
            "fragment": "gedungkesenian",
            "link": "tamanbudaya/index.html#gedungkesenian",
            "sceneId": "node10"
        },
        {
            "infoId": 219,
            "label": "Theater Gedung Ki Narto Sabdo",
            "description": "Ruang Theater Gedung Ki Narto Sabdo: Ruang teater atau pertunjukan ini adalah jantung dari Gedung Ki Narto Sabdo, dirancang khusus sebagai gedung kesenian dengan kapasitas sekitar 500 orang penonton. Ruangan ini secara rutin digunakan untuk pagelaran seni panggung seperti wayang orang dan teater.",
            "fragment": "theater",
            "link": "tamanbudaya/index.html#theater",
            "sceneId": "node23"
        }
