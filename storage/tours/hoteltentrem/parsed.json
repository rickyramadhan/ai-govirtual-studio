    "objects": [
        {
            "infoId": 450,
            "label": "Presidential Suite",
            "description": "Presidential Suite merupakan tipe akomodasi teratas yang menawarkan kemewahan dan privasi maksimal, biasanya dilengkapi dengan fasilitas lengkap seperti ruang tamu, ruang makan pribadi, dan layanan butler eksklusif. Suite ini dirancang untuk tamu penting dengan dekorasi yang elegan dan pemandangan kota yang spektakuler dari jendela besar.",
            "fragment": "presidentialsuite",
            "link": "hoteltentrem/index.html#presidentialsuite",
            "sceneId": "node27"
        },
        {
            "infoId": 451,
            "label": "Sidomuncul Gallery",
            "description": "Sidomuncul Gallery adalah ruang pameran dan toko yang terletak di lobi hotel, menampilkan beragam produk jamu dari Sido Muncul serta koleksi batik. Fasilitas ini memungkinkan tamu untuk berbelanja produk khas dan menikmati keindahan seni batik sebagai warisan budaya Indonesia.",
            "fragment": "sidomunculgallery",
            "link": "hoteltentrem/index.html#sidomunculgallery",
            "sceneId": "node2"
        },
        {
            "infoId": 452,
            "label": "Deluxe Room",
            "description": "Deluxe Room adalah salah satu kategori kamar standar yang menawarkan akomodasi nyaman dengan desain interior mewah Peranakan yang elegan dan fasilitas kamar mandi lengkap. Kamar ini memberikan suasana tenang dan sering kali menyajikan pemandangan kolam renang atau pemandangan kota.",
            "fragment": "deluxeroom",
            "link": "hoteltentrem/index.html#deluxeroom",
            "sceneId": ""
        },
        {
            "infoId": 453,
            "label": "Executive Lounge",
            "description": "Executive Lounge adalah fasilitas eksklusif yang hanya dapat diakses oleh tamu kamar Executive dan Suite, berfungsi sebagai ruang privat untuk bersantai, bekerja, atau menikmati makanan ringan. Fasilitas ini menawarkan keuntungan tambahan seperti layanan check-in pribadi dan cocktail hour gratis.",
            "fragment": "executivelounge",
            "link": "hoteltentrem/index.html#executivelounge",
            "sceneId": "node9"
        },
        {
            "infoId": 454,
            "label": "Ballroom",
            "description": "Ballroom adalah aula besar yang berfungsi sebagai tempat serbaguna untuk menyelenggarakan acara besar, seperti resepsi pernikahan, konferensi, atau pameran dengan kapasitas yang luas. Ruangan ini didukung dengan teknologi audio-visual canggih dan layanan katering profesional.",
