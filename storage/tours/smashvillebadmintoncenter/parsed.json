    "objects": [
        {
            "infoId": 932,
            "label": "Phoenix Billiard",
            "description": "Tempat ini mengusung konsep interior premium dengan perpaduan elemen kayu dan pencahayaan lampu LED dekoratif yang menghadirkan atmosfer elegan dan futuristik bagi para pengunjung. Dari sisi fasilitas, setiap meja biliar dilengkapi pencahayaan panel atas yang optimal untuk mendukung akurasi permainan, serta ruangan berpendingin udara (AC) penuh guna menjaga kenyamanan selama bermain.",
            "fragment": "billiard",
            "link": "smashville/index.html#billiard",
            "sceneId": "node5"
        },
        {
            "infoId": 933,
            "label": "Badminton",
            "description": "Tempat ini dikenal luas sebagai destinasi olahraga yang nyaman karena memiliki 8 lapangan yang telah memenuhi standar Federasi Bulu Tangkis Dunia (BWF) dengan lantai berbahan vinyl berkualitas tinggi agar tidak licin saat digunakan. Selain area lapangan yang luas, Smashville juga dilengkapi dengan fasilitas pendukung seperti papan skor digital, sirkulasi udara yang segar, area parkir yang memadai, serta toilet yang sangat bersih.",
            "fragment": "badminton",
            "link": "smashville/index.html#badminton",
            "sceneId": "node7"
        },
        {
            "infoId": 934,
            "label": "Cafe",
            "description": "Cafe di Phoenix Billiard Semarang menawarkan konsep area tunggu dan bersantai yang modern dengan desain interior industrial yang hangat. Selain itu, tersedia bar pelayanan dengan aksen kayu yang rapi serta fasilitas stopkontak di bawah deretan sofa panjang, menjadikannya tempat yang fungsional bagi pengunjung untuk mengisi daya perangkat elektronik sambil menikmati suasana di sela-sela permainan biliar.",
            "fragment": "cafe",
            "link": "smashville/index.html#cafe",
            "sceneId": "node3"
        }
    ],
