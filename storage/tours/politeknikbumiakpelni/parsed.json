    "objects": [
        {
            "infoId": 169,
            "label": "Simulator Jembatan",
            "description": "Fasilitas pelatihan canggih berupa replika anjungan kapal sesungguhnya yang digunakan untuk mensimulasikan olah gerak dan navigasi kapal. Simulator ini bertujuan meningkatkan kompetensi taruna Nautika agar mampu mengendalikan kapal, menguasai peralatan navigasi, dan merespons berbagai kondisi laut sebelum mereka berlayar di laut nyata.",
            "fragment": "simulatorjembatan",
            "link": "politeknikakpelni/index.html#simulatorjembatan",
            "sceneId": "node109"
        },
        {
            "infoId": 170,
            "label": "Anjungan Kapal",
            "description": "Fasilitas replika anjungan kapal di Politeknik Bumi Akpelni Semarang adalah Full Mission Ship Handling Simulator (FMSS) yang meniru secara persis ruang kemudi (anjungan) kapal sungguhan. Fasilitas ini digunakan untuk melatih taruna Nautika secara realistis dalam manuver, navigasi, dan manajemen sumber daya anjungan (BRM) untuk menghadapi berbagai skenario operasional dan darurat di laut.",
            "fragment": "anjungankapal",
            "link": "politeknikakpelni/index.html#anjungankapal",
            "sceneId": "node89"
        },
        {
            "infoId": 171,
            "label": "Lab Bahasa",
            "description": "Sarana pendukung akademik yang dirancang khusus untuk pengembangan intensif keterampilan berbahasa asing para taruna, terutama Bahasa Inggris. Lab ini memiliki peran penting dalam menunjang kompetensi lulusan agar memiliki standarisasi Bahasa Inggris yang diakui secara internasional, sesuai tuntutan dunia maritim global.",
            "fragment": "labbahasa",
            "link": "politeknikakpelni/index.html#labbahasa",
            "sceneId": "node96"
        },
        {
            "infoId": 172,
            "label": "LAB KOMPUTER",
            "description": "Sarana praktik yang menyediakan perangkat keras (PC) dan perangkat lunak yang memadai, dilengkapi dengan akses internet dan AC, untuk menunjang kegiatan akademik taruna. Laboratorium ini berfungsi sebagai pendukung utama kegiatan praktikum, perkuliahan, dan pengembangan keterampilan digital yang esensial dalam menunjang kompetensi lulusan di dunia kerja maritim.",
            "fragment": "labkomputer",
            "link": "politeknikakpelni/index.html#labkomputer",
            "sceneId": "node95"
        },
        {
            "infoId": 173,
            "label": "Pusat Simulator Navigasi",
            "description": "Navigation Simulator Center adalah ruangan simulasi canggih yang digunakan untuk melatih taruna Nautika dalam olah gerak dan navigasi kapal niaga secara virtual. Simulator ini penting untuk meningkatkan kompetensi taruna dalam hal watch keeping, meteorologi, dan penerapan aturan pencegahan tabrakan di laut (Collision Regulation).",
            "fragment": "pusatsimulatornavigasi",
            "link": "politeknikakpelni/index.html#pusatsimulatornavigasi",
            "sceneId": "node108"
        },
        {
            "infoId": 174,
            "label": "LAB FMERS",
            "description": "Fasilitas Full Mission Engine Room Simulator (FMERS) di Politeknik Bumi Akpelni Semarang adalah replika ruang kontrol kamar mesin kapal lengkap yang dirancang untuk mensimulasikan operasional dan kondisi mesin di atas kapal. Simulator ini bertujuan melatih taruna Teknika secara intensif dalam mengelola, mengoperasikan, dan mengatasi gangguan pada sistem utama mesin kapal sebelum mereka terjun ke praktik laut.",
            "fragment": "labfmers",
            "link": "politeknikakpelni/index.html#labfmers",
            "sceneId": "node94"
        },
        {
            "infoId": 175,
            "label": "GMDSS",
            "description": "Global Maritime Distress and Safety System (GMDSS) di Politeknik Bumi Akpelni Semarang adalah laboratorium simulator komunikasi maritim yang berfokus pada sistem keselamatan global untuk pelayaran. Simulator ini digunakan untuk melatih taruna mengoperasikan peralatan komunikasi darurat seperti VHF, EPIRB, dan SART, guna memastikan mereka kompeten dalam mengirim dan menerima berita marabahaya di laut sesuai standar internasional.",
            "fragment": "gmdss",
            "link": "politeknikakpelni/index.html#gmdss",
            "sceneId": "node91"
        },
        {
            "infoId": 176,
            "label": "Lab Mesin Kapal induk",
            "description": "Lab Mesin Kapal Induk (Engine Simulator) Fasilitas ini sebenarnya dikenal sebagai Engine Simulator (Simulator Mesin Kapal) dan bukan spesifik kapal induk. Engine Simulator adalah ruang praktik yang digunakan taruna Teknika Kapal untuk mempelajari dan mengoperasikan sistem permesinan kapal, termasuk main engine, sistem pendinginan, dan sistem bahan bakar.",
            "fragment": "labmesinkapal",
            "link": "politeknikakpelni/index.html#labmesinkapal",
            "sceneId": "node110"
        }
    ],
