    "objects": [
        {
            "infoId": 919,
            "label": "Mural Kampung Batik",
            "description": "Mural-mural ini diciptakan sebagai bagian dari revitalisasi kampung untuk menarik wisatawan sekaligus mempertegas identitas wilayah tersebut sebagai sentra batik legendaris yang sempat mati suri setelah pertempuran lima hari di Semarang.",
            "fragment": "muralkampungbatik",
            "link": "kampungdjadoel/index.html#muralkampungbatik",
            "sceneId": "node6"
        },
        {
            "infoId": 920,
            "label": "Laksmi Art Batik",
            "description": "Laksmi Art Batik merupakan salah satu galeri sekaligus bengkel batik yang menjadi ikon penting di kawasan Kampung Batik Semarang. Selain memproduksi karya seni, Laksmi Art Batik juga memposisikan dirinya sebagai pusat edukasi wisata atau edutourism. Di tempat ini, pengunjung tidak sekadar datang untuk berbelanja, melainkan dapat mengikuti lokakarya (workshop) membatik.",
            "fragment": "laksmibatik",
            "link": "kampungdjadoel/index.html#laksmibatik",
            "sceneId": "node5"
        },
        {
            "infoId": 921,
            "label": "Batik Balqis",
            "description": "Batik Balqis memiliki spesialisasi yang kuat pada fashion siap pakai (ready-to-wear) serta penyediaan kain batik berkualitas. Koleksi mereka didominasi oleh motif-motif khas Semarangan, seperti Lawang Sewu, Tugu Muda, dan Asem Arang, yang diaplikasikan baik pada batik tulis maupun cap.",
            "fragment": "batikbalqis",
            "link": "kampungdjadoel/index.html#batikbalqis",
            "sceneId": "node2"
        },
        {
            "infoId": 922,
            "label": "Rusyda Batik",
            "description": "Rusyda Batik tidak hanya sekadar toko, melainkan sebuah representasi dari ketekunan pengrajin lokal yang menjaga teknik membatik secara manual, baik itu batik tulis maupun batik cap, yang seluruh pengerjaannya melibatkan warga sekitar demi pemberdayaan ekonomi komunitas.",
            "fragment": "rusydabatik",
            "link": "kampungdjadoel/index.html#rusydabatik",
            "sceneId": "node10"
        },
        {
            "infoId": 923,
            "label": "Omah Batik Ngesti Pandowo",
            "description": "Omah Batik Ngesti Pandowo memiliki keunggulan dalam kemampuan adaptasinya terhadap tantangan produksi dan pasar. Tidak hanya mengandalkan metode tradisional sepenuhnya, mereka juga mulai mengadopsi teknologi tepat guna, seperti penggunaan alat pengering khusus (smart dryer) untuk mengatasi kendala cuaca yang sering menghambat proses produksi batik, terutama saat musim hujan.",
            "fragment": "batikpandowo",
            "link": "kampungdjadoel/index.html#batikpandowo",
            "sceneId": "node9"
        }
    ],
