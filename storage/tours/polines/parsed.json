    "objects": [
        {
            "infoId": 370,
            "label": "Lab Mesin",
            "description": "Lab Mesin adalah fasilitas praktik yang menyediakan berbagai peralatan dan mesin industri yang relevan dengan bidang teknik mesin. Laboratorium ini digunakan oleh mahasiswa untuk mengaplikasikan teori, merancang, dan menguji komponen-komponen mekanik.",
            "fragment": "labmesin",
            "link": "polines/index.html#labmesin",
            "sceneId": "node284"
        },
        {
            "infoId": 371,
            "label": "Lab Akuntansi",
            "description": "Lab Akuntansi merupakan ruang praktik yang dilengkapi dengan perangkat lunak dan simulasi keuangan untuk mendukung kegiatan praktikum mahasiswa akuntansi. Laboratorium ini bertujuan untuk melatih keahlian mahasiswa dalam pencatatan transaksi, analisis laporan keuangan, dan audit.",
            "fragment": "labakuntansi",
            "link": "polines/index.html#labakuntansi",
            "sceneId": "node290"
        },
        {
            "infoId": 372,
            "label": "Lab Elektro",
            "description": "Lab Elektro adalah fasilitas yang dilengkapi dengan perangkat keras dan perangkat lunak untuk praktik bidang elektronika, listrik, dan kendali. Laboratorium ini memungkinkan mahasiswa untuk merangkai sirkuit, menguji perangkat, dan mengembangkan sistem otomatisasi.",
            "fragment": "labelektro",
            "link": "polines/index.html#labelektro",
            "sceneId": "node285"
        },
        {
            "infoId": 373,
            "label": "Lapangan Tennis",
            "description": "Lapangan Tennis adalah fasilitas olahraga yang digunakan oleh mahasiswa dan civitas akademika untuk latihan maupun pertandingan tenis. Lapangan ini menunjang aktivitas kebugaran dan kegiatan Unit Kegiatan Mahasiswa (UKM) olahraga.",
            "fragment": "lapangantenis",
            "link": "polines/index.html#lapangantenis",
            "sceneId": "node299"
        },
        {
            "infoId": 374,
            "label": "Lapangan Basket",
            "description": "Lapangan Basket adalah area yang disediakan untuk kegiatan olahraga bola basket, baik untuk perkuliahan mata kuliah umum maupun untuk pengembangan bakat. Lapangan ini menjadi salah satu sarana utama dalam memfasilitasi kegiatan Unit Kegiatan Mahasiswa (UKM) dan turnamen internal.",
            "fragment": "lapanganbasket",
            "link": "polines/index.html#lapanganbasket",
            "sceneId": "node280"
        },
        {
            "infoId": 375,
            "label": "Lapangan Bola",
            "description": "Lapangan Bola adalah area terbuka yang digunakan untuk kegiatan olahraga sepak bola dan terkadang untuk upacara, apel, atau kegiatan outdoor kampus lainnya. Lapangan ini menjadi sarana penting untuk melatih fisik dan mendukung kegiatan Unit Kegiatan Mahasiswa (UKM) sepak bola/futsal.",
            "fragment": "lapanganbola",
            "link": "polines/index.html#lapanganbola",
            "sceneId": "node293"
        }
