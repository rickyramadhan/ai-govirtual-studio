    "objects": [
        {
            "infoId": 1075,
            "label": "Aula",
            "description": "Fasilitas ini merupakan ruang pertemuan berkapasitas besar yang ideal untuk menyelenggarakan acara formal seperti pernikahan atau pertemuan perusahaan. Ruangannya dirancang dengan arsitektur kayu khas pesisir yang memberikan kesan megah namun tetap menyatu dengan suasana pesisir.",
            "fragment": "aula",
            "link": "kampunglaut/index.html#aula",
            "sceneId": "node89"
        },
        {
            "infoId": 1076,
            "label": "Ruang Makan",
            "description": "Area ini berupa ruangan dengan sirkulasi terbuka yang berisi beberapa meja makan dan dilengkapi dengan fasilitas live music. Sehingga suasana bersantap hidangan laut di kampung laut menjadi lebih nyaman dan lebih hidup.",
            "fragment": "ruangmakan",
            "link": "kampunglaut/index.html#ruangmakan",
            "sceneId": "node86"
        },
        {
            "infoId": 1077,
            "label": "Area Makan Outdoor",
            "description": "Area makan outdoor di Kampung Laut Semarang menawarkan suasana santai dengan konsep semi-terbuka yang menghadap ke danau, sehingga pengunjung dapat menikmati hidangan sambil merasakan angin sepoi-sepoi dan pemandangan alam sekitar. Restoran ini terkenal dengan menu seafood dan masakan khas Nusantara yang cocok dinikmati bersama keluarga maupun rombongan. Tersedia gazebo, tempat duduk lesehan, serta meja kursi di area terbuka yang membuat suasana makan terasa lebih nyaman dan alami. Selain itu, fasilitas seperti area parkir luas, mushola, dan playground anak juga menambah kenyamanan pengunjung yang datang.",
            "fragment": "areamakanoutdoor",
            "link": "kampunglaut/index.html#areamakanoutdoor",
            "sceneId": "node80"
        },
        {
            "infoId": 1078,
            "label": "Ruang VIP",
            "description": "Ruangan eksklusif yang lebih privat dan tenang serta dilengkapi dengan pendingin ruangan (AC), sangat cocok untuk pertemuan bisnis atau acara keluarga yang membutuhkan privasi tinggi. Fasilitas ini dilengkapi dengan layanan khusus dan interior yang lebih mewah dibandingkan area umum lainnya.",
            "fragment": "ruangvip",
            "link": "kampunglaut/index.html#ruangvip",
            "sceneId": "node101"
        },
        {
            "infoId": 1079,
            "label": "Area Memancing",
            "description": "Fasilitas rekreasi yang memungkinkan pengunjung menyalurkan hobi memancing sambil menunggu hidangan disiapkan. Area ini mengelilingi restoran dan menjadi daya tarik utama bagi keluarga yang ingin menikmati suasana santai di tepi tambak.",
            "fragment": "areamemancing",
            "link": "kampunglaut/index.html#areamemancing",
            "sceneId": "node97"
        },
        {
            "infoId": 1080,
            "label": "Taman Bermain",
            "description": "Untuk menjaga si kecil tetap terhibur. Lokasinya strategis sehingga orang tua tetap bisa mengawasi anak-anak bermain sambil menikmati hidangan dengan tenang.",
            "fragment": "tamanbermain",
            "link": "kampunglaut/index.html#tamanbermain",
            "sceneId": "node82"
        }
    ],
