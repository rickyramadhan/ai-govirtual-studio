    "objects": [
        {
            "infoId": 679,
            "label": "Rumah Produksi Kue Basah",
            "description": "Hampir setiap rumah di gang-gang kampung ini memiliki spesialisasi tersendiri; ada keluarga yang khusus memproduksi kue ku, ada yang ahli membuat lemper, arem-arem, putu ayu, hingga dadar gulung. Model industri rumahan ini menjadikan kampung tersebut tidak sekadar pemukiman, melainkan sebuah \"pabrik raksasa\" terdesentralisasi yang digerakkan oleh ibu-ibu rumah tangga dan warga sekitar.",
            "fragment": "rumahproduksikue",
            "link": "kampungayu/index.html#rumahproduksikue",
            "sceneId": "node7"
        },
        {
            "infoId": 680,
            "label": "Rumah Produksi Tas",
            "description": "Karakteristik produksi tas di kawasan ini umumnya berfokus pada tas-tas fungsional dengan harga yang terjangkau atau tas custom untuk keperluan grosir. Produk yang dihasilkan bervariasi, mulai dari tas sekolah, tas suvenir hajatan, goodie bag seminar, hingga tas wanita model terbaru yang mengikuti tren pasar.",
            "fragment": "rumahproduksitas",
            "link": "kampungayu/index.html#rumahproduksitas",
            "sceneId": "node13"
        },
        {
            "infoId": 681,
            "label": "Rumah Produksi Kerajinan Tangan",
            "description": "Jenis kerajinan yang dihasilkan di Bangetayu Kulon umumnya berbasis pada pemanfaatan limbah atau bahan daur ulang, sejalan dengan program pemerintah Semarang mengenai \"Bank Sampah\" dan kampung tematik. Rumah-rumah produksi ini sering mengubah limbah rumah tangga atau sisa kain perca (limbah konveksi sekitar) menjadi barang bernilai jual.",
            "fragment": "kerajinantangan",
            "link": "kampungayu/index.html#kerajinantangan",
            "sceneId": "node9"
        }
    ],
