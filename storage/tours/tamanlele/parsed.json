    "objects": [
        {
            "infoId": 902,
            "label": "Danau Taman Lele",
            "description": "Danau yang memiliki fungsi sebagai wahana hiburan air dan pemandangan utama penginapan. Terdapat aktivitas becak air (perahu bebek) untuk berkeliling di atas danau yang menjadi tempat favorit anak-anak dan pasangan. Danau ini dikelilingi oleh pepohonan rindang dan gazebo, sehingga udaranya cukup sejuk meskipun Semarang terkenal panas.",
            "fragment": "danautamanlele",
            "link": "kampungwisatatamanlele/index.html#danautamanlele",
            "sceneId": "node47"
        },
        {
            "infoId": 903,
            "label": "Kolam Renang",
            "description": "Kolam renang Taman Lele bukanlah waterpark mewah dengan wahana ekstrem, melainkan kolam renang rekreasi keluarga yang santai, teduh, dan ramah di kantong. Tempat ini sangat cocok untuk mengajak anak-anak bermain air di akhir pekan. Air yang digunakan berasal dari sumber mata air alami di kawasan tersebut, sehingga terasa lebih segar dan dingin dibandingkan air olahan biasa.",
            "fragment": "kolamrenang",
            "link": "kampungwisatatamanlele/index.html#kolamrenang",
            "sceneId": "node37"
        },
        {
            "infoId": 904,
            "label": "Kolam Lele",
            "description": "Di kolam ini terdapat lele jumbo atau lele berukuran raksasa yang jauh lebih besar dari lele konsumsi di pasar. Pengunjung (terutama anak-anak) diperbolehkan memberi makan ikan di kolam ini. Pakan ikan (pelet) biasanya dijual oleh pengelola di sekitar lokasi dengan harga murah. Melihat ribuan lele berebut makanan adalah atraksi yang seru bagi anak-anak.",
            "fragment": "kolamlele",
            "link": "kampungwisatatamanlele/index.html#kolamlele",
            "sceneId": "node38"
        },
        {
            "infoId": 905,
            "label": "Penginapan",
            "description": "Penginapan Taman Lele sangat cocok sebagai tempat transit murah dan strategis di jalur Pantura Semarang Barat, yang ingin merasakan sensasi menginap sederhana dengan pemandangan danau dan pepohonan rimbun. Tamu yang menginap biasanya bebas biaya tiket masuk ke area wisata Taman Lele.",
