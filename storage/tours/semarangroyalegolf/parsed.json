    "objects": [
        {
            "infoId": 272,
            "label": "Golf Car Finish",
            "description": "Golf Car Finish adalah area penempatan akhir atau dropping point untuk golf cart (mobil golf) setelah digunakan pemain mengelilingi lapangan. Area ini memastikan mobil-mobil golf dikelola dengan baik dan selalu siap untuk round berikutnya.",
            "fragment": "golfcarfinish",
            "link": "royalegolf/index.html#golfcarfinish",
            "sceneId": "node100"
        },
        {
            "infoId": 273,
            "label": "Lapangan Golf",
            "description": "Lapangan Golf merupakan fasilitas inti yang menyediakan area bermain 18 hole dengan tata letak yang indah dan menantang. Lapangan ini dirancang dengan kualitas premium dan memiliki unsur-unsur seperti tee box, fairway, rough, dan green yang terawat.",
            "fragment": "lapangangolf",
            "link": "royalegolf/index.html#lapangangolf",
            "sceneId": "node105"
        },
        {
            "infoId": 274,
            "label": "Cafe dan Resto",
            "description": "Cafe dan Resto adalah fasilitas tempat bersantap yang menyajikan beragam pilihan makanan dan minuman bagi para pegolf maupun pengunjung umum. Restoran ini terletak di clubhouse modern dan menawarkan pemandangan lapangan yang menenangkan.",
            "fragment": "aicafe",
            "link": "royalegolf/index.html#aicafe",
            "sceneId": "node92"
        },
        {
            "infoId": 275,
            "label": "Ruang VIP",
            "description": "Ruang VIP merupakan ruangan privat atau eksklusif yang disediakan untuk pertemuan bisnis, acara khusus, atau networking informal dengan privasi lebih. Ruangan ini cocok untuk acara korporat atau komunitas karena menawarkan suasana yang nyaman dan profesional.",
            "fragment": "ruangvip",
            "link": "royalegolf/index.html#ruangvip",
            "sceneId": "node82"
        },
        {
            "infoId": 276,
            "label": "Pro Shop",
            "description": "Pro Shop adalah toko ritel khusus yang menjual berbagai macam perlengkapan dan aksesori golf yang berkualitas, mulai dari stik, bola, hingga pakaian. Fasilitas ini memudahkan pegolf untuk mendapatkan atau mengganti peralatan yang dibutuhkan sebelum maupun sesudah bermain.",
            "fragment": "proshop",
            "link": "royalegolf/index.html#proshop",
            "sceneId": "node101"
        },
        {
