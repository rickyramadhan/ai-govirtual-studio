    "objects": [
        {
            "infoId": 130,
            "label": "Loker Room",
            "description": "Fasilitas esensial yang terletak di dalam clubhouse golf, berfungsi sebagai ruang ganti yang dilengkapi dengan loker penyimpanan barang, serta kamar mandi dan fasilitas kebersihan bagi para pegolf. Ruangan ini dirancang untuk memberikan kenyamanan kepada anggota dan pengunjung agar dapat bersiap sebelum bermain dan membersihkan diri setelah menyelesaikan putaran golf.",
            "fragment": "lokerroom",
            "link": "candigolf/index.html#lokerroom",
            "sceneId": "node200"
        },
        {
            "infoId": 131,
            "label": "Driving Range 2",
            "description": "Area latihan yang disediakan khusus untuk pegolf pemula memukul bola berulang kali guna mengasah teknik pukulan jarak jauh mereka. Meskipun beberapa ulasan menyebut driving range-nya mungkin tidak terlalu luas, fasilitas ini ideal untuk pemula maupun profesional yang ingin latihan harian dengan harga terjangkau.",
            "fragment": "drivingrange2",
            "link": "candigolf/index.html#drivingrange2",
            "sceneId": "node190"
        },
        {
            "infoId": 132,
            "label": "Lapangan hole 5",
            "description": "Lapangan golf di Candi Golf Semarang (Graha Candi Golf) merupakan lapangan golf 9 hole dengan Par 36 yang dirancang menantang dengan kontur perbukitan. Lapangan ini menawarkan pemandangan indah Kota Semarang dari ketinggian, menjadikannya pilihan unik untuk rekreasi golf.",
            "fragment": "lapanganhall5",
            "link": "candigolf/index.html#lapanganhall5",
            "sceneId": "node198"
        },
        {
            "infoId": 133,
            "label": "Golf Cart",
            "description": "Area yang menunjukkan batas atau area tertentu di fairway di mana kereta golf (golf car) wajib berhenti dan tidak diperbolehkan melintas lebih jauh ke depan. Aturan ini bertujuan untuk melindungi green dan fairway dari kerusakan ban kereta serta menjaga kualitas rumput di area kritis.",
            "fragment": "golfcart",
            "link": "candigolf/index.html#golfcart",
            "sceneId": "node193"
        },
        {
            "infoId": 134,
            "label": "Restoran",
            "description": "Fasilitas kuliner yang terletak di kawasan clubhouse, menyediakan tempat makan dan bersosialisasi yang nyaman bagi para pegolf dan pengunjung. Di sekitar area tersebut, terdapat beberapa pilihan area makan seperti indoor dan outdoor yang sama-sama menyediakan kenyamanan.",
            "fragment": "restoran",
            "link": "candigolf/index.html#restoran",
            "sceneId": "node203"
        }
    ],
