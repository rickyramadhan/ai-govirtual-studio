    "objects": [
        {
            "infoId": 1081,
            "label": "Tempat Wudhu",
            "description": "Tempat wudhu di Masjid Agung Semarang (Kauman) dirancang fungsional dan aksesibel untuk melayani tingginya mobilitas jamaah yang beragam, mulai dari warga lokal, musafir, hingga para pedagang dan pengunjung Pasar Djohar.",
            "fragment": "",
            "link": "NULL",
            "sceneId": ""
        },
        {
            "infoId": 1082,
            "label": "Ruang sholat",
            "description": "Area sholat utama di Masjid Agung Semarang (Kauman) menawarkan atmosfer yang sangat sakral, hening, dan kental dengan nuansa sejarah yang seolah membawa jamaah kembali ke masa lampau. Didominasi oleh arsitektur tradisional Jawa yang megah, ruang utama ini ditopang oleh empat tiang penyangga utama atau saka guru dari kayu jati solid berukuran besar yang melambangkan kekuatan pondasi bangunan sekaligus spiritualitas.",
            "fragment": "ruangsholat",
            "link": "masjidkauman/index.html#ruangsholat",
            "sceneId": "node262"
        },
        {
            "infoId": 1083,
            "label": "Aloon-aloon Masjid Agung Semarang",
            "description": "Kawasan ini telah direvitalisasi secara total oleh pemerintah dan dikembalikan fungsinya sebagai ruang terbuka publik yang hijau dan asri. Saat ini, alun-alun tersebut menjadi halaman depan yang megah bagi masjid, memisahkan area sakral tempat ibadah dengan hiruk-pikuk aktivitas perdagangan di Pasar Johar, sekaligus mengembalikan konsep \"Catur Gatra Tunggal\" (kesatuan antara pusat pemerintahan, ibadah, pasar, dan penjara/alun-alun) yang dulu menjadi ciri khas pusat kota Semarang.",
            "fragment": "aloonaloon",
            "link": "masjidkauman/index.html#aloonaloon",
            "sceneId": "node274"
        }
    ],
