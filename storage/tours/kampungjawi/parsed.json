    "objects": [
        {
            "infoId": 257,
            "label": "Spot Foto Menara",
            "description": "Spot foto menara ikonik di Kampung Jawi Semarang adalah menara pandang yang estetik, seringkali dibangun dari batu bata merah dan dilengkapi lampu dekoratif. Menara ini berfungsi sebagai titik pandang yang populer bagi pengunjung untuk mendapatkan latar belakang suasana desa tradisional Jawa yang asri dan tenang, terutama saat malam hari.",
            "fragment": "spotfoto",
            "link": "kampungjawi/index.html#spotfoto",
            "sceneId": "node116"
        },
        {
            "infoId": 258,
            "label": "UMKM",
            "description": "UMKM di Kampung Jawi Semarang menjual kuliner warga setempat seperti makanan dan minuman tradisional Jawa. Keberadaan UMKM kuliner ini sangat berperan penting sebagai penunjang pariwisata, sekaligus membantu meningkatkan perekonomian masyarakat lokal.",
            "fragment": "umkm",
            "link": "kampungjawi/index.html#umkm",
            "sceneId": "node114"
        },
        {
            "infoId": 259,
            "label": "Counter Penukaran Kepeng",
            "description": "Konter penukaran kepeng di Kampung Jawi adalah pusat penukaran mata uang Rupiah menjadi koin Kepeng (kepingan kayu) yang wajib dilakukan pengunjung sebelum bertransaksi di area kuliner Pasar Jaten. Kepeng ini berfungsi sebagai alat pembayaran unik berkonsep tradisional Jawa tempo dulu, dan sisa Kepeng dapat ditukarkan kembali menjadi Rupiah saat pulang.",
            "fragment": "counterpenukaran",
            "link": "kampungjawi/index.html#counterpenukaran",
            "sceneId": "node117"
        },
        {
            "infoId": 260,
            "label": "Aula Pendopo",
            "description": "Aula atau Pendopo di Kampung Jawi berfungsi sebagai panggung utama untuk pertunjukan seni dan budaya tradisional Jawa, seperti musik gamelan, tarian, atau teater rakyat. Pendopo ini memperkuat nuansa kampung Jawa tempo dulu dan menjadi pusat hiburan bagi pengunjung yang sedang menikmati kuliner di area sekitarnya.",
            "fragment": "aulapendopo",
            "link": "kampungjawi/index.html#aulapendopo",
            "sceneId": "node118"
        }
    ],
