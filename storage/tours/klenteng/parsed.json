    "objects": [
        {
            "infoId": 331,
            "label": "Altar Tian Khonghucu",
            "description": "Altar Tian Kong Altar ini terletak di bangunan paling depan Klenteng Hwie Wie Kiong dan dikhususkan sebagai tempat sembahyang kepada Tuhan Yang Maha Kuasa (Thian Kong atau Thi Kong). Posisi ini menunjukkan penghormatan tertinggi dalam tata ruang klenteng, di mana ibadah ditujukan kepada otoritas tertinggi.",
            "fragment": "altartiankong",
            "link": "klentenghwiewiekiong/index.html#altartiankong",
            "sceneId": "node8"
        },
        {
            "infoId": 333,
            "label": "Altar Tan Kha Pee",
            "description": "Altar Tan Kha Pee adalah altar yang diperuntukan untuk penghormatan terhadap salah satu leluhur keluarga Tan.",
            "fragment": "altartankhapee",
            "link": "klentenghwiewiekiong/index.html#altartankhapee",
            "sceneId": "node3"
        },
        {
            "infoId": 334,
            "label": "Altar Poo Seng Tay Tee, Altar Kuan Tee Koen, Altar Kwan Im",
            "description": "Altar Poo Seng Tay Tee (Dewa Pengobatan) dan Kuan Tee Koen (Dewa Keadilan/Perang) ditempatkan di ruang tambahan atau sisi Klenteng untuk memohon kesehatan dan keberanian/kesetiaan. Sementara itu, altar Kwan Im (Dewi Welas Asih) juga tersedia, mencerminkan pemujaan terhadap figur Bodhisattva dalam tradisi Buddha untuk memohon kasih sayang dan perlindungan.",
            "fragment": "altarpooseng",
            "link": "klentenghwiewiekiong/index.html#altarpooseng",
            "sceneId": "node4"
        },
        {
            "infoId": 335,
            "label": "Altar Hok Tek Tjeng Sin",
            "description": "Altar Hok Tek Tjeng Sin (Dewa Bumi) di Klenteng Hwie Wie Kiong adalah altar utama yang melambangkan permohonan rezeki, kemakmuran, dan perlindungan bagi umat. Selain itu, penempatan altar ini juga sering disertai altar untuk Houw Tjiang Koen (harimau peliharaan) di bawahnya, sebagai simbol penjaga dan pelindung Dewa Bumi.",
            "fragment": "altarhoktek",
            "link": "klentenghwiewiekiong/index.html#altarhoktek",
            "sceneId": "node2"
        },
        {
            "infoId": 336,
            "label": "Altar Utama Shin Chi",
            "description": "Fasilitas altar Sin Ci (papan arwah) di Klenteng Hwie Wie Kiong terletak di bagian Balai Leluhur, berupa lemari-lemari yang memuat ribuan papan arwah keluarga Tan yang disusun bertingkat. Fasilitas ini berfungsi sebagai tempat utama bagi anggota marga Tan untuk beribadah, mengenang, dan melacak silsilah leluhur mereka, dengan meja persembahan khusus di depannya.",
            "fragment": "altarutama",
            "link": "klentenghwiewiekiong/index.html#altarutama",
            "sceneId": "node5"
        },
        {
            "infoId": 332,
            "label": "Altar Gay Tjiang Seng Ong",
            "description": "Altar Gay Tjiang Seng Ong (Dewa Perang dan Pembangunan) merupakan fasilitas utama yang terletak di ruangan tengah Klenteng Hwie Wie Kiong, karena beliau adalah Dewa Pelindung dan Tuan Rumah Klenteng yang dihormati oleh keluarga Tan. Altar ini menjadi pusat peribadatan utama bagi umat untuk memuja Sang Dewa, yang diyakini membawa kebajikan, keberanian, dan kesejahteraan.",
            "fragment": "altargaytjiang",
            "link": "klentenghwiewiekiong/index.html#altargaytjiang",
            "sceneId": "node10"
        }
    ],
