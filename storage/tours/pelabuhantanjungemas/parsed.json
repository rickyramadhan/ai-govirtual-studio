    "objects": [
        {
            "infoId": 924,
            "label": "Lobby Terminal",
            "description": "Lobby Terminal Pelabuhan Tanjung Emas Semarang berfungsi sebagai area utama penerimaan dan pelayanan penumpang. Area ini dirancang dengan tata ruang yang rapi untuk mendukung kelancaran alur kedatangan dan keberangkatan.",
            "fragment": "lobbyterminal",
            "link": "tanjungemas/index.html#lobbyterminal",
            "sceneId": "node1"
        },
        {
            "infoId": 925,
            "label": "Ruang Tunggu",
            "description": "Ruang Tunggu menyediakan fasilitas yang nyaman bagi penumpang sebelum naik atau setelah turun dari kapal. Lingkungan yang bersih dan tertata mendukung kenyamanan selama menunggu.",
            "fragment": "ruangtunggu",
            "link": "tanjungemas/index.html#ruangtunggu",
            "sceneId": "node3"
        },
        {
            "infoId": 927,
            "label": "Pintu Ramp",
            "description": "Sebagai jembatan penghubung antara dermaga dan geladak kapal (car deck). Ini memungkinkan kendaraan seperti truk, mobil, dan sepeda motor untuk masuk atau keluar dari kapal secara mandiri.",
            "fragment": "pinturamp",
            "link": "tanjungemas/index.html#pinturamp",
            "sceneId": "node9"
        }
