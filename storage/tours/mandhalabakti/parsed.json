    "objects": [
        {
            "infoId": 125,
            "label": "Kisah Perjalanan Diponegoro",
            "description": "Museum Mandala Bhakti menyimpan jejak perjuangan Pangeran Diponegoro, yang dikenal memimpin Perang Jawa (1825â€“1830) dengan strategi gerilya melawan penjajah Belanda. Koleksi terkait beliau yang dapat dilihat meliputi lukisan yang menjelaskan kisah perjalanannya, replika pakaian, dan berbagai jenis senjata yang digunakan dalam pertempuran.",
            "fragment": "kisahdiponegoro",
            "link": "mandalabhakti/index.html#kisahdiponegoro",
            "sceneId": "node5"
        },
        {
            "infoId": 126,
            "label": "Ruang G30SPKI",
            "description": "Museum Mandala Bhakti memiliki Ruang G30S/PKI yang didedikasikan untuk memamerkan dokumentasi dan arsip visual terkait peristiwa Gerakan 30 September, sebagai bagian dari sejarah perjuangan TNI dalam mempertahankan keutuhan negara. Ruangan ini bertujuan untuk memberikan gambaran mengenai sejarah kelam tersebut kepada pengunjung dan menjadi bagian dari rekam jejak pengabdian Kodam IV/Diponegoro.",
            "fragment": "ruangg30spki",
