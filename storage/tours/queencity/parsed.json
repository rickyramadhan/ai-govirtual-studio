    "objects": [
        {
            "infoId": 1189,
            "label": "Kamar Tidur",
            "description": "Kamar tidur di apartemen servis ini dirancang dengan standar kenyamanan tinggi yang memadukan estetika modern dan suasana hangat untuk beristirahat. Setiap unit dilengkapi dengan tempat tidur berkualitas premium serta pencahayaan yang diatur untuk menjamin ketenangan tamu selama menginap.",
            "fragment": "bedroom",
            "link": "queencitymall/index.html#bedroom",
            "sceneId": "node83"
        },
        {
            "infoId": 1190,
            "label": "Ruang Tamu",
            "description": "Ruang tamu menyediakan area bersantai yang luas dan elegan, lengkap dengan fasilitas hiburan serta jendela besar yang menawarkan pemandangan kota Semarang. Desain interiornya dibuat fungsional agar tamu merasa seperti berada di rumah sendiri, baik untuk menerima kunjungan maupun bekerja secara santai.",
            "fragment": "livingroom",
            "link": "queencitymall/index.html#livingroom",
            "sceneId": "node102"
        },
        {
            "infoId": 1191,
            "label": "Taman Kuliner",
            "description": "Food Park adalah pusat kuliner atau food court yang menyajikan beragam pilihan hidangan dalam satu area. Tempat ini menjadi lokasi favorit pengunjung untuk bersantap dengan suasana yang santai dan pilihan menu yang variatif.",
            "fragment": "foodpark",
            "link": "queencitymall/index.html#foodpark",
            "sceneId": "node97"
        },
        {
            "infoId": 1192,
            "label": "Jalur Promenade",
            "description": "Area ini merupakan jalur pedestrian semi-terbuka yang dirancang untuk memberikan pengalaman berjalan kaki yang menyenangkan sambil menikmati suasana mall. Promenadewalk kali dilengkapi dengan berbagai gerai menarik dan menjadi spot populer untuk bersosialisasi atau sekadar bersantai.",
            "fragment": "promenadewalk",
            "link": "queencitymall/index.html#promenadewalk",
            "sceneId": "node80"
        },
        {
            "infoId": 1193,
            "label": "Jalan Harajuku",
            "description": "Harajuku Street adalah zona tematik unik yang mengadopsi gaya distrik mode ternama di Jepang dengan dekorasi yang sangat instagrammable. Area ini menghadirkan pengalaman belanja dan kuliner bernuansa Jepang yang kreatif serta penuh warna bagi para pengunjung.",
            "fragment": "harajukustreet",
            "link": "queencitymall/index.html#harajukustreet",
            "sceneId": "node89"
        }
    ],
