    "objects": [
        {
            "infoId": 284,
            "label": "JEMBATAN MERAH",
            "description": "Jembatan Merah adalah salah satu ikon di kawasan ini yang berfungsi sebagai penghubung dan sering menjadi lokasi fotografi berkat arsitektur klasiknya. Meskipun tidak semasyhur yang di Surabaya, jembatan ini menandai kawasan Kota Lama dan pintu masuk ke Kampung Melayu.",
            "fragment": "jembatanmerah",
            "link": "kampungmelayu/index.html#jembatanmerah",
            "sceneId": "node12"
        },
        {
            "infoId": 285,
            "label": "Masjid Menara Layur",
            "description": "Masjid ini adalah bangunan cagar budaya yang didirikan saudagar Yaman dan memiliki menara unik setinggi 20 meter yang dahulu berfungsi sebagai mercusuar/penanda pelaut. Dikenal dengan atap tajug tiga tingkatnya, masjid ini mencerminkan akulturasi arsitektur Jawa dan Arab, serta dikenal dengan tradisi buka puasa Kopi Arab-nya.",
            "fragment": "masjidlayur",
            "link": "kampungmelayu/index.html#masjidlayur",
            "sceneId": "node15"
        },
        {
            "infoId": 286,
            "label": "Klenteng Kan Hok Bio",
            "description": "Klenteng Hoo Hok Bio (Sinar Dewa di Gang Cilik). Klenteng ini berfungsi sebagai tempat ibadah Tridharma (Buddha, Tao, Konghucu) yang sakral dan memuja Kongco (leluhur), dihiasi dengan interior tradisional Tionghoa.",
            "fragment": "kanhokbio",
            "link": "kampungmelayu/index.html#kanhokbio",
            "sceneId": "node13"
        },
        {
            "infoId": 287,
            "label": "Taman dan Landmark",
            "description": "Berupa area terbuka, pintu gerbang masuk kawasan Kampung Melayu. Terdapat landmark, gazebo, dan spot tugu perahu yang menjadi ciri khas kawasan Kampung Melayu dahulu kala.",
            "fragment": "tamanlandmark,-16.31,7.53,135.02",
            "link": "kampungmelayu/index.html#tamanlandmark,-16.31,7.53,135.02",
            "sceneId": ""
        }
