    "objects": [
        {
            "infoId": 1048,
            "label": "Pusat Oleh-Oleh",
            "description": "Rumah Makan Asem-Asem Koh Liem tidak hanya menjual makanan siap santap, tetapi juga menyediakan kemasan beku (frozen) dari menu andalannya, Asem-Asem Daging, yang praktis untuk dibawa pulang sebagai oleh-oleh. Selain itu, mereka sering menawarkan berbagai menu lauk khas rumahan lainnya yang juga bisa dibeli dalam jumlah banyak untuk dibawa pulang.",
            "fragment": "pusatoleholeh",
            "link": "asemasemkohliem/index.html#pusatoleholeh",
            "sceneId": "node21"
        },
        {
            "infoId": 1049,
            "label": "Sejarah dan Area Makan",
            "description": "Warung Asem-Asem Koh Liem adalah kuliner legendaris Semarang yang telah berdiri sejak tahun 1978 oleh pendirinya, Piek Swie Liem, bermula dari jualan kaki lima hingga kini dikelola generasi penerusnya. Area makannya mengusung nuansa klasik mirip warteg, di mana aneka lauk pauk disusun di lemari kaca dan tempat duduk pelanggan mengelilingi bar tempat peracikan makanan.",
            "fragment": "sejarahareamakan",
            "link": "asemasemkohliem/index.html#sejarahareamakan",
            "sceneId": "node22"
        },
        {
            "infoId": 1050,
            "label": "Ruang Rapat",
            "description": "Warung Asem-Asem Koh Liem dikenal dengan konsep warung makan sederhana yang fokus pada kuliner legendaris bergaya warteg atau masakan rumahan. Restoran ini memiliki fasilitas ruang meeting khusus, dengan ruang makan utama yang dilengkapi meja dan kursi.",
            "fragment": "ruangrapat",
            "link": "asemasemkohliem/index.html#ruangrapat",
            "sceneId": "node35"
        },
        {
            "infoId": 1051,
            "label": "Area Makan Ruang Merokok",
            "description": "Warung Asem-Asem Koh Liem dikenal dengan konsep warung makan sederhana yang fokus pada kuliner legendaris bergaya warteg atau masakan rumahan yang juga menyediakan area khusus untuk smoking room.",
            "fragment": "areamerokok",
            "link": "asemasemkohliem/index.html#areamerokok",
            "sceneId": "node31"
        }
    ],
