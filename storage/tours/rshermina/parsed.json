    "objects": [
        {
            "infoId": 182,
            "label": "Taman Void",
            "description": "Fasilitas Taman Void di RS Hermina Banyumanik Semarang merujuk pada area terbuka di tengah bangunan (void) yang didesain menjadi ruang hijau atau taman dalam ruangan. Taman ini berfungsi sebagai area relaksasi bagi pasien dan pengunjung serta memberikan suasana asri dan pencahayaan alami untuk menciptakan lingkungan penyembuhan yang nyaman dan tenang.",
            "fragment": "tamanvoid",
            "link": "rsherminabanyumanik/index.html#tamanvoid",
            "sceneId": "node106"
        },
        {
            "infoId": 183,
            "label": "CT Scan",
            "description": "Fasilitas CT Scan (Computed Tomography Scan) di RS Hermina Banyumanik Semarang merupakan salah satu layanan unggulan yang tersedia di Instalasi Radiologi rumah sakit tersebut. Alat canggih ini digunakan untuk menghasilkan gambar rinci berbagai bagian tubuh (seperti tulang, organ, atau pembuluh darah) secara cepat dan akurat, sangat membantu dokter dalam menegakkan diagnosis, terutama dalam kondisi darurat.",
            "fragment": "ctscan",
            "link": "rsherminabanyumanik/index.html#ctscan",
            "sceneId": "node94"
        },
        {
