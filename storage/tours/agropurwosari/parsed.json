    "objects": [
        {
            "infoId": 266,
            "label": "Greenhouse Hidroponik Melon",
            "description": "Greenhouse Hidroponik Melon adalah ruang metode budidaya melon premium di dalam bangunan tertutup transparan yang berfungsi mengontrol suhu dan kelembaban lingkungan tanam. Sistem ini memungkinkan tanaman melon tumbuh optimal tanpa menggunakan tanah, melainkan mendapatkan nutrisi lengkap langsung dari larutan air untuk menghasilkan buah berkualitas tinggi.",
            "fragment": "hidroponikmelon",
            "link": "agropurwosari/index.html#hidroponikmelon",
            "sceneId": "node8"
        },
        {
            "infoId": 267,
            "label": "Greenhouse Hidroponik Sayur",
            "description": "Greenhouse hidroponik sayur adalah fasilitas tertutup yang dirancang untuk membudidayakan sayuran tanpa tanah, menggunakan larutan nutrisi yang dialirkan langsung ke akar. Sistem ini memungkinkan pengendalian penuh terhadap iklim mikro, suhu, dan nutrisi, sehingga menghasilkan panen sayur yang bersih, optimal, dan bebas hama.",
            "fragment": "hidroponiksayur",
            "link": "agropurwosari/index.html#hidroponiksayur",
            "sceneId": "node4"
        },
        {
            "infoId": 268,
            "label": "Greenhouse Hidroponik Anggur",
            "description": "Greenhouse Hidroponik Anggur adalah bangunan tertutup dengan atap transparan yang dirancang khusus untuk menciptakan iklim mikro yang ideal dan terlindungi bagi budidaya tanaman anggur. Tujuannya adalah memaksimalkan pertumbuhan dan kualitas buah anggur sepanjang tahun, serta meminimalkan risiko kerusakan akibat cuaca ekstrem, hujan, atau serangan hama.",
            "fragment": "hidroponikanggur",
            "link": "agropurwosari/index.html#hidroponikanggur",
            "sceneId": "node5"
        },
        {
            "infoId": 269,
            "label": "Kebun Kelengkeng",
            "description": "Kebun Kelengkeng adalah lahan pertanian yang dikhususkan untuk membudidayakan pohon kelengkeng (Dimocarpus longan) secara terorganisir dan intensif dalam skala komersial. Tujuannya adalah menghasilkan buah kelengkeng dalam jumlah besar untuk dijual, baik sebagai komoditas pangan maupun untuk mendukung agrowisata.",
            "fragment": "kebunkelengkeng",
            "link": "agropurwosari/index.html#kebunkelengkeng",
            "sceneId": "node2"
        },
        {
            "infoId": 270,
            "label": "Amphitheater",
            "description": "Amphitheater adalah struktur tribun berundak terbuka yang dibangun di dalam kawasan kebun atau taman, berfungsi sebagai pusat pertemuan dan pertunjukan. Tempat ini digunakan khusus untuk kegiatan pendidikan, presentasi hasil penelitian, workshop, atau pementasan seni yang berkaitan dengan pertanian dan lingkungan kepada pengunjung.",
            "fragment": "amphitheater",
            "link": "agropurwosari/index.html#amphitheater",
            "sceneId": "node10"
        },
        {
            "infoId": 271,
            "label": "Plaza",
            "description": "Plaza adalah area publik terbuka yang dirancang khusus sebagai ruang interaksi non-formal, yang dilengkapi dengan elemen atau fasilitas pendukung proses belajar-mengajar. Tempat ini berfungsi sebagai pusat aktivitas komunitas, pameran, atau workshop yang bertujuan menyampaikan informasi dan pengetahuan secara santai dan rekreatif.",
            "fragment": "plaza",
            "link": "agropurwosari/index.html#plaza",
            "sceneId": "node11"
        }
    ],
